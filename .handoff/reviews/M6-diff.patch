--- /dev/null
+++ b/app/pages/ops/access-log.vue
@@ -0,0 +1,148 @@
+<!-- FE-20 AccessLogPage (S13, EP-13, SEQ-11): every role grant, removal and refused attempt in a month, newest first,
+     25 at a time (EP-38). Owns ST-7 in the URL (`month`) and ST-8; "Show 25 more" fetches the next cursor and appends,
+     as FE-15 does. Only the finance lead sees entries; anyone else gets the Permission denied state and none of them. -->
+<script setup lang="ts">
+import { ROLE_LABELS } from '~/components/ops-access/RoleDialog.vue'
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface AccessLogEntry {
+  at: string
+  actor_display_name: string
+  target_display_name: string
+  from_role: string
+  to_role: string
+  reason: string
+  outcome: 'granted' | 'refused'
+}
+interface AccessLogPage { data: AccessLogEntry[]; next_cursor: string | null }
+
+const COPY = {
+  forbidden: 'Only the finance lead reviews the access log.',
+  internal: "We couldn't load the access log. Try again.",
+}
+
+useHead({ title: 'Access log' })
+const route = useRoute()
+const thisMonth = new Date().toISOString().slice(0, 7)
+const month = computed(() => (typeof route.query.month === 'string' && route.query.month) || thisMonth) // ST-7
+const monthName = computed(() => new Date(`${month.value}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }))
+const { data: first, error, refresh, status } = await useFetch<AccessLogPage>('/api/ops/access-log', { query: { month } }) // ST-8
+
+const problemOf = (e: unknown): Problem => (e as { data?: Problem })?.data ?? { type: '/problems/internal' }
+const problem = computed<Problem | null>(() => (error.value ? problemOf(error.value) : null))
+// S13 Permission denied, signed out: the sign-in page with the idle message.
+if (problem.value?.type === '/problems/unauthenticated') await navigateTo({ path: '/sign-in', query: { next: route.fullPath, idle: '1' } })
+
+const more = ref<AccessLogEntry[]>([])
+const nextCursor = ref<string | null>(null)
+const loadingMore = ref(false)
+const moreProblem = ref<Problem | null>(null)
+let gen = 0 // bumps when the month or the first page changes, so a late Show 25 more page is dropped
+watch(month, () => gen++)
+watch(first, (p) => {
+  gen++
+  more.value = []
+  moreProblem.value = null
+  nextCursor.value = p?.next_cursor ?? null
+}, { immediate: true })
+const entries = computed(() => [...(first.value?.data ?? []), ...more.value])
+
+async function showMore() {
+  if (!nextCursor.value || loadingMore.value) return
+  const g = gen
+  loadingMore.value = true
+  try {
+    const page = await $fetch<AccessLogPage>('/api/ops/access-log', { query: { month: month.value, cursor: nextCursor.value } })
+    if (g !== gen) return
+    more.value.push(...page.data)
+    nextCursor.value = page.next_cursor
+    moreProblem.value = null
+  } catch (e: unknown) {
+    if (g === gen) moreProblem.value = problemOf(e)
+  } finally {
+    loadingMore.value = false
+  }
+}
+
+// S13 Loading: "Loading the access log…", then after 10 s "Still loading."
+const slow = ref(false)
+let slowTimer: ReturnType<typeof setTimeout> | undefined
+watch(status, (s) => {
+  clearTimeout(slowTimer)
+  slow.value = false
+  if (s === 'pending') slowTimer = setTimeout(() => (slow.value = true), 10_000)
+})
+onBeforeUnmount(() => clearTimeout(slowTimer))
+
+const pickMonth = (m: string) => navigateTo({ query: m ? { month: m } : {} })
+const label = (role: string) => ROLE_LABELS[role] ?? role
+// UTC on server and browser alike, so the SSR text and the hydrated text match.
+const when = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'UTC' })
+const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })
+const change = (e: AccessLogEntry) => `${label(e.from_role)} to ${label(e.to_role)}`
+const refusedText = (e: AccessLogEntry) =>
+  e.actor_display_name === e.target_display_name
+    ? `Refused: ${e.actor_display_name} tried to change their own role.`
+    : `Refused: ${e.actor_display_name} tried to change ${e.target_display_name} from ${change(e)}.`
+// S13 Accessibility: each entry is read as one sentence.
+const sentence = (e: AccessLogEntry) =>
+  e.outcome === 'refused'
+    ? `${day(e.at)}, ${refusedText(e)} ${e.reason}`
+    : `${day(e.at)}, ${e.actor_display_name} changed ${e.target_display_name} from ${change(e)}: ${e.reason}`
+const count = computed(() => {
+  const n = entries.value.length
+  return `${n}${nextCursor.value ? ' or more' : ''} role change${n === 1 && !nextCursor.value ? '' : 's'} in ${monthName.value}.`
+})
+</script>
+
+<template>
+  <AppShell>
+    <section class="access-log" aria-labelledby="access-log-heading">
+      <div class="page-band"><h1 id="access-log-heading">Access log</h1></div>
+      <ProblemMessage v-if="problem?.type === '/problems/forbidden'" :problem="problem" :copy="COPY" />
+      <template v-else>
+        <div class="controls"><MonthPicker :value="month" @change="pickMonth" /></div>
+        <p v-if="status === 'pending'" role="status">{{ slow ? 'Still loading.' : 'Loading the access log…' }}</p>
+        <ProblemMessage v-else-if="problem" :problem="problem" :copy="COPY" @retry="refresh()" />
+        <div v-else-if="first" class="card">
+          <p v-if="entries.length === 0" role="status">No roles changed in {{ monthName }}.</p>
+          <template v-else>
+            <p role="status">{{ count }} Times in UTC.</p>
+            <table class="list">
+              <thead>
+                <tr><th scope="col">When</th><th scope="col">Who acted</th><th scope="col">For</th><th scope="col">Change</th><th scope="col">Reason</th></tr>
+              </thead>
+              <tbody>
+                <tr v-for="(e, i) in entries" :key="i" :aria-label="sentence(e)">
+                  <td>{{ when(e.at) }}</td>
+                  <td>{{ e.actor_display_name }}</td>
+                  <td>{{ e.target_display_name }}</td>
+                  <td>
+                    <strong v-if="e.outcome === 'refused'" class="refused">{{ refusedText(e) }}</strong>
+                    <template v-else>{{ change(e) }}</template>
+                  </td>
+                  <td>{{ e.reason }}</td>
+                </tr>
+              </tbody>
+            </table>
+            <ProblemMessage v-if="moreProblem" :problem="moreProblem" :copy="COPY" @retry="showMore" />
+            <button v-if="nextCursor" type="button" class="btn-secondary" :disabled="loadingMore" @click="showMore">Show 25 more</button>
+          </template>
+        </div>
+      </template>
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.controls { margin: 8px 0; }
+.list { width: 100%; border-collapse: collapse; }
+.list th, .list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; vertical-align: top; }
+.refused { color: var(--color-danger); }
+.btn-secondary { min-height: 24px; margin-top: 8px; }
+@media (max-width: 600px) {
+  .list thead { display: none; }
+  .list tr { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-button); margin-bottom: 8px; padding: 4px; }
+  .list td { display: block; border: 0; padding: 2px 4px; }
+}
+</style>
diff --git a/app/pages/ops/access.vue b/app/pages/ops/access.vue
new file mode 100644
index 0000000..c558891
--- /dev/null
+++ b/app/pages/ops/access.vue
@@ -0,0 +1,184 @@
+<!-- FE-19 OperationsAccessPage (S12, EP-12, SEQ-10): the operations people, one role each (EP-36), and the role dialog
+     that saves a change with a reason (EP-37). Owns ST-11, the dialog draft, and one Idempotency-Key per save, kept for
+     its retries. The SRE's own row has no Change role button. -->
+<script setup lang="ts">
+import { ROLE_LABELS, type RoleDraft, type RoleDraftErrors } from '~/components/ops-access/RoleDialog.vue'
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface StaffMember {
+  user_id: number
+  display_name: string
+  role: string
+  role_since: string | null
+  is_you: boolean
+}
+interface StaffList {
+  data: StaffMember[]
+}
+
+const FORBIDDEN = 'Only the SRE can change operations roles.'
+const SELF = "You can't change your own role."
+
+useHead({ title: 'Operations access' })
+const route = useRoute()
+const { data: list, error, refresh, status } = await useFetch<StaffList>('/api/ops/staff') // ST-8
+
+const editing = ref<StaffMember | null>(null)
+const draft = ref<RoleDraft>({ role: 'none', reason: '' }) // ST-11
+const errors = ref<RoleDraftErrors>({})
+const key = ref<string | null>(null)
+const confirmed = ref(false)
+const saving = ref(false)
+const slow = ref(false)
+const success = ref('')
+
+const label = (role: string) => ROLE_LABELS[role] ?? role
+// UTC on server and browser alike, so the SSR text and the hydrated text match.
+const since = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' }) : '-')
+const slugOf = (p?: Problem | null) => p?.type?.replace('/problems/', '')
+const onlyMe = computed(() => !!list.value && list.value.data.every((s) => s.is_you || s.role === 'none'))
+// S12 Permission denied, signed out: the sign-in page with the idle message.
+const toSignIn = () => navigateTo({ path: '/sign-in', query: { next: route.fullPath, idle: '1' } })
+if (slugOf(error.value?.data as Problem | undefined) === 'unauthenticated') await toSignIn()
+
+function open(s: StaffMember) {
+  editing.value = s
+  draft.value = { role: s.role, reason: '' }
+  errors.value = {}
+  key.value = null
+  confirmed.value = false
+  success.value = ''
+}
+function close() {
+  const id = editing.value?.user_id
+  editing.value = null
+  nextTick(() => document.getElementById(`change-${id}`)?.focus())
+}
+function onChange(d: RoleDraft) {
+  draft.value = d
+  key.value = null // a different request needs its own key
+  confirmed.value = false
+}
+
+async function save() {
+  const s = editing.value
+  if (!s || saving.value) return
+  if (draft.value.reason.trim() === '') {
+    errors.value = { reason: 'Add a reason so the finance lead knows why.' }
+    return
+  }
+  errors.value = {}
+  saving.value = true
+  const timer = setTimeout(() => (slow.value = true), 10_000)
+  key.value ??= crypto.randomUUID()
+  try {
+    const saved = await $fetch<StaffMember>(`/api/ops/staff/${s.user_id}/role`, {
+      method: 'PUT',
+      headers: { 'idempotency-key': key.value },
+      body: { role: draft.value.role, reason: draft.value.reason.trim(), expected_role: s.role, confirm_no_finance_lead: confirmed.value },
+    })
+    success.value = `Saved. ${saved.display_name} is now ${label(saved.role)}. The finance lead will see this in the access log.`
+    close()
+    await refresh()
+  } catch (e: unknown) {
+    const data = (e as { data?: Problem & { currentRole?: string } }).data
+    const slug = slugOf(data)
+    if (slug === 'unauthenticated') {
+      await toSignIn()
+    } else if (slug === 'forbidden') {
+      errors.value = { form: FORBIDDEN }
+    } else if (slug === 'self-role-change') {
+      errors.value = { form: SELF }
+    } else if (slug === 'idempotency-in-flight') {
+      errors.value = { form: "Still saving. Don't close this window." }
+    } else if (slug === 'last-finance-lead') {
+      // The review step for a binding change (WCAG 3.3.4): the next Save sends the confirmation, with a new key since the body differs.
+      errors.value = { confirm: 'No one will be able to run financial reports. Remove anyway?' }
+      confirmed.value = true
+      key.value = null
+    } else if (slug === 'stale-role') {
+      errors.value = { form: `${s.display_name} was changed a moment ago to ${label(data!.currentRole ?? '')}. Check before saving.` }
+      await refresh()
+      editing.value = list.value?.data.find((x) => x.user_id === s.user_id) ?? s
+      key.value = null
+    } else if (slug === 'validation') {
+      errors.value = { reason: 'Add a reason so the finance lead knows why.' }
+    } else if (!navigator.onLine) {
+      errors.value = { form: "You're offline. Access is unchanged." }
+    } else {
+      errors.value = { form: `We couldn't save the role. ${s.display_name}'s access is unchanged. Try again.` }
+    }
+  } finally {
+    clearTimeout(timer)
+    saving.value = false
+    slow.value = false
+  }
+}
+const pageProblem = computed<Problem | null>(() => (error.value ? (error.value.data as Problem) ?? { type: '/problems/internal' } : null))
+</script>
+
+<template>
+  <AppShell>
+    <section class="access" aria-labelledby="access-heading">
+      <div class="page-band"><h1 id="access-heading">Operations access</h1></div>
+      <p v-if="status === 'pending' && !list" role="status">Loading people…</p>
+      <ProblemMessage v-else-if="pageProblem" :problem="pageProblem" :copy="{ forbidden: FORBIDDEN }" @retry="refresh()" />
+      <div v-else-if="list" class="card">
+        <p class="success" role="status">{{ success }}</p>
+        <p v-if="onlyMe">Only you have a role so far. Give others the role their work needs.</p>
+        <table class="list">
+          <thead>
+            <tr>
+              <th scope="col">Person</th><th scope="col">Role</th><th scope="col">Since</th>
+              <th scope="col"><span class="visually-hidden">Actions</span></th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr v-for="s in list.data" :key="s.user_id">
+              <td>{{ s.display_name }}</td>
+              <td>{{ label(s.role) }}</td>
+              <td>{{ since(s.role_since) }}</td>
+              <td>
+                <span v-if="s.is_you">(you) <span class="helper">{{ SELF }}</span></span>
+                <button
+                  v-else
+                  :id="`change-${s.user_id}`"
+                  type="button"
+                  class="btn-primary"
+                  :aria-label="`Change role for ${s.display_name}`"
+                  @click="open(s)"
+                >
+                  Change role
+                </button>
+              </td>
+            </tr>
+          </tbody>
+        </table>
+        <p class="helper">Every change appears in the access log for the finance lead.</p>
+      </div>
+      <OpsAccessRoleDialog
+        v-if="editing"
+        :name="editing.display_name"
+        :draft="draft"
+        :errors="errors"
+        :saving="saving"
+        :slow="slow"
+        @change="onChange"
+        @save="save"
+        @cancel="close"
+      />
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.list { width: 100%; border-collapse: collapse; }
+.list th, .list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
+.helper { margin: 2px 0; color: var(--color-ink-muted); font-size: var(--text-detail); }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
+@media (max-width: 600px) {
+  .list thead { display: none; }
+  .list tr { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-button); margin-bottom: 8px; padding: 4px; }
+  .list td { display: block; border: 0; padding: 2px 4px; }
+}
+</style>
diff --git a/app/pages/ops/finance.vue b/app/pages/ops/finance.vue
new file mode 100644
index 0000000..bf37c78
--- /dev/null
+++ b/app/pages/ops/finance.vue
@@ -0,0 +1,147 @@
+<!-- FE-18 FinancialReportPage (S11, EP-11, SEQ-9): the balance equation first (FE-12), revenue two ways, then each
+     provider's payout (25 at a time). Owns ST-7 in the URL (`month`, or `from` and `to`) and ST-8 (EP-34). Export is a
+     plain link to EP-35 with the same query, so the browser downloads it. Order numbers only, never a patient. -->
+<script setup lang="ts">
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface ProviderPayout { provider_display_name: string; practice_name: string; payout_cents: number }
+interface FinancialReport {
+  from: string
+  to: string
+  patient_payments_cents: number
+  item_cost_cents: number
+  provider_payouts_cents: number
+  platform_fees_cents: number
+  balanced: boolean
+  gap_cents: number
+  gap_order_ids: number[]
+  gross_revenue_cents: number
+  net_revenue_cents: number
+  payouts_by_provider: ProviderPayout[]
+}
+
+useHead({ title: 'Financial report' })
+const route = useRoute()
+const str = (v: unknown) => (typeof v === 'string' ? v : '')
+const thisMonth = new Date().toISOString().slice(0, 7)
+// ST-7: a range when both dates are given, otherwise a month ('' = the current month, as the server reads it).
+const range = computed(() => (str(route.query.from) && str(route.query.to) ? { from: str(route.query.from), to: str(route.query.to) } : null))
+const month = computed(() => str(route.query.month) || thisMonth)
+const query = computed(() => range.value ?? { month: month.value })
+const { data: r, error, refresh, status } = await useFetch<FinancialReport>('/api/ops/finance/report', { query }) // ST-8
+
+const dollars = (c: number) => `$${(c / 100).toFixed(2)}`
+const dateName = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
+const periodName = computed(() =>
+  range.value
+    ? `${dateName(range.value.from)} to ${dateName(range.value.to)}`
+    : new Date(`${month.value}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
+)
+const exportHref = computed(() => `/api/ops/finance/export?${new URLSearchParams(query.value).toString()}`)
+const parts = computed(() =>
+  r.value
+    ? [
+        { label: 'item cost', cents: r.value.item_cost_cents },
+        { label: 'provider payouts', cents: r.value.provider_payouts_cents },
+        { label: 'platform fees', cents: r.value.platform_fees_cents },
+      ]
+    : [],
+)
+const empty = computed(() => !!r.value && r.value.patient_payments_cents === 0 && r.value.payouts_by_provider.length === 0 && r.value.gap_order_ids.length === 0)
+const shown = ref(25)
+watch(query, () => (shown.value = 25))
+
+const problem = computed<Problem | null>(() => (error.value ? ((error.value.data as Problem) ?? { type: '/problems/internal' }) : null))
+// S11 Permission denied, signed out: the sign-in page with the idle message.
+if (problem.value?.type === '/problems/unauthenticated') await navigateTo({ path: '/sign-in', query: { next: route.fullPath, idle: '1' } })
+
+const pickMonth = (m: string) => navigateTo({ query: m ? { month: m } : {} })
+const fromInput = ref(range.value?.from ?? '')
+const toInput = ref(range.value?.to ?? '')
+const pickRange = () => {
+  if (fromInput.value && toInput.value) navigateTo({ query: { from: fromInput.value, to: toInput.value } })
+}
+</script>
+
+<template>
+  <AppShell>
+    <section class="finance" aria-labelledby="finance-heading">
+      <div class="page-band"><h1 id="finance-heading">Financial report</h1></div>
+      <ProblemMessage
+        v-if="problem && problem.type === '/problems/forbidden'"
+        :problem="problem"
+        :copy="{ forbidden: 'Only the finance lead can run financial reports.' }"
+      />
+      <template v-else>
+        <div class="controls card">
+          <fieldset class="period">
+            <legend>Period</legend>
+            <p class="helper">A month, or choose a start and end date.</p>
+            <MonthPicker :value="range ? '' : month" @change="pickMonth" />
+            <form class="range" @submit.prevent="pickRange">
+              <label>From <input v-model="fromInput" type="date" required></label>
+              <label>To <input v-model="toInput" type="date" required></label>
+              <button type="submit" class="btn-secondary">Show range</button>
+            </form>
+          </fieldset>
+          <a v-if="r" :href="exportHref" class="btn-primary export" download>Export {{ periodName }}</a>
+        </div>
+
+        <p v-if="status === 'pending'" role="status">Building {{ periodName }}…</p>
+        <ProblemMessage
+          v-else-if="problem"
+          :problem="problem"
+          :copy="{ internal: 'We couldn\'t build the report. Try again.' }"
+          @retry="refresh"
+        />
+        <template v-else-if="r">
+          <div class="card">
+            <h2>{{ range ? `${dateName(r.from)} to ${dateName(r.to)}` : periodName }}</h2>
+            <p v-if="empty" role="status">No orders were paid in {{ periodName }}. Every total is $0.00.</p>
+            <OpsMoneyEquation :total="r.patient_payments_cents" :parts="parts" :balanced="r.balanced" period :gap-order-ids="r.gap_order_ids" />
+          </div>
+
+          <div class="card">
+            <h2>Revenue, two views (your accountant decides which applies)</h2>
+            <dl class="revenue">
+              <dt>Gross:</dt><dd><span class="amount">{{ dollars(r.gross_revenue_cents) }}</span> all patient payments</dd>
+              <dt>Net:</dt><dd><span class="amount">{{ dollars(r.net_revenue_cents) }}</span> platform fees only</dd>
+            </dl>
+          </div>
+
+          <div class="card">
+            <h2>Payouts by provider</h2>
+            <p v-if="r.payouts_by_provider.length === 0">No provider payouts in {{ periodName }}.</p>
+            <ul v-else class="payouts">
+              <li v-for="p in r.payouts_by_provider.slice(0, shown)" :key="`${p.provider_display_name}|${p.practice_name}`">
+                <span>{{ p.provider_display_name }} · {{ p.practice_name }}</span><span class="amount">{{ dollars(p.payout_cents) }}</span>
+              </li>
+            </ul>
+            <button v-if="r.payouts_by_provider.length > shown" type="button" class="btn-secondary" @click="shown += 25">Show 25 more</button>
+          </div>
+          <p class="note">Records are kept for at least 3 years.</p>
+        </template>
+      </template>
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.card { margin-bottom: var(--space-section); }
+.controls { display: flex; flex-wrap: wrap; gap: var(--space-card); align-items: flex-start; justify-content: space-between; }
+.period { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; }
+.period legend { font-weight: 600; padding: 0; }
+.helper, .note { color: var(--color-ink-muted); margin: 0; }
+.range { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+.range input { min-height: 24px; }
+.export { display: inline-flex; align-items: center; text-decoration: none; }
+.revenue { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0; }
+.revenue dd { margin: 0; }
+.amount { font-variant-numeric: tabular-nums; font-weight: 600; }
+.payouts { list-style: none; margin: 0; padding: 0; }
+.payouts li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
+@media (max-width: 600px) {
+  .revenue { grid-template-columns: 1fr; }
+  .payouts li { flex-direction: column; }
+}
+</style>
diff --git a/app/pages/ops/health.vue b/app/pages/ops/health.vue
new file mode 100644
index 0000000..bb61aa5
--- /dev/null
+++ b/app/pages/ops/health.vue
@@ -0,0 +1,128 @@
+<!-- FE-17 PlatformHealthPage (S10-V2, EP-10, SEQ-8): the month's order funnel, measures past their alert line pinned on
+     top, and volume per practice, totals only (FR-053): nothing here links to a single order. Owns ST-7 (`month` in the
+     URL) and ST-8; practice rows show 25 at a time from the list already fetched. -->
+<script setup lang="ts">
+import type { Problem } from '~/components/ProblemMessage.vue'
+import type { Funnel } from '~/components/ops-health/OrderFunnel.vue'
+
+interface Measure { name: string; value: number; alert_line: number | null; needs_attention: boolean }
+interface PracticeVolume { practice_name: string; paid_cents: number; fees_cents: number; orders_sent: number; orders_paid: number }
+interface PlatformHealth {
+  month: string
+  funnel: Funnel
+  median_minutes_to_pay: number | null
+  out_of_stock_refusals: number
+  orders_needing_review: number
+  measures: Measure[]
+  practices: PracticeVolume[]
+}
+
+useHead({ title: 'Platform health' })
+const route = useRoute()
+const thisMonth = new Date().toISOString().slice(0, 7)
+const month = computed(() => (typeof route.query.month === 'string' && route.query.month) || thisMonth)
+const { data: h, error, refresh, status } = await useFetch<PlatformHealth>('/api/ops/health', { query: { month } }) // ST-8
+
+const problem = computed<Problem | null>(() => (error.value ? ((error.value.data as Problem) ?? { type: '/problems/internal' }) : null))
+if (problem.value?.type === '/problems/unauthenticated') await navigateTo({ path: '/sign-in', query: { next: route.fullPath, idle: '1' } })
+
+const monthName = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
+const monthOnly = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', timeZone: 'UTC' })
+const dollars = (c: number) => `$${(c / 100).toFixed(2)}`
+const duration = (min: number) => (min < 60 ? `${min} min` : `${Math.round((min / 60) * 10) / 10} h`)
+
+const flagged = computed(() => h.value?.measures.filter((m) => m.needs_attention) ?? [])
+const flaggedText = (m: Measure) => `${m.name} (${m.value})`
+const attention = computed(() => {
+  const f = flagged.value
+  if (f.length === 0) return ''
+  return f.length === 1 ? `1 measure needs attention: ${flaggedText(f[0]!)}` : `${f.length} measures need attention:`
+})
+const reviewFlagged = computed(() => flagged.value.some((m) => m.name === 'orders needing review'))
+const fewOrders = computed(() => !!h.value && h.value.funnel.sent > 0 && h.value.funnel.sent < 5)
+
+const shown = ref(25) // local UI: practice rows revealed from the list already fetched
+watch(month, () => (shown.value = 25))
+const pickMonth = (m: string) => navigateTo({ query: m ? { month: m } : {} })
+</script>
+
+<template>
+  <AppShell>
+    <section class="health" aria-labelledby="health-heading">
+      <div class="page-band"><h1 id="health-heading">Platform health</h1></div>
+      <ProblemMessage
+        v-if="problem && problem.type === '/problems/forbidden'"
+        :problem="problem"
+        :copy="{ forbidden: 'Only operations staff can see platform health.' }"
+      />
+      <template v-else>
+        <div class="card controls">
+          <MonthPicker :value="month" @change="pickMonth" />
+        </div>
+        <p v-if="status === 'pending'" role="status">Loading {{ monthName(month) }}…</p>
+        <ProblemMessage
+          v-else-if="problem"
+          :problem="problem"
+          :copy="{ internal: `We couldn't load ${monthOnly(month)}'s figures. Try again.` }"
+          @retry="refresh"
+        />
+        <template v-else-if="h">
+          <div v-if="attention" class="card attention">
+            <p><strong>! {{ attention }}</strong></p>
+            <ul v-if="flagged.length > 1">
+              <li v-for="m in flagged" :key="m.name">{{ flaggedText(m) }}</li>
+            </ul>
+          </div>
+          <div class="card">
+            <h2>Order funnel</h2>
+            <p role="status">{{ h.funnel.sent === 0 ? `No orders were sent in ${monthName(h.month)}.` : `Showing ${monthName(h.month)}.` }}</p>
+            <OpsHealthOrderFunnel :funnel="h.funnel" />
+            <p v-if="fewOrders" class="note">Few orders this month; read the counts, not the bars.</p>
+            <p v-if="h.median_minutes_to_pay !== null">Median time from sent to paid: {{ duration(h.median_minutes_to_pay) }}</p>
+          </div>
+          <div class="card">
+            <p>
+              Out-of-stock refusals {{ h.out_of_stock_refusals }} · Orders needing review {{ h.orders_needing_review }}
+              <span v-if="reviewFlagged" class="status-pill status-pill--needs_review">! Needs attention</span>
+            </p>
+            <p class="note">Alert line set after 30 days of orders.</p>
+          </div>
+          <div class="card">
+            <h2>In-house volume by practice</h2>
+            <table class="volume">
+              <thead>
+                <tr><th scope="col">Practice</th><th scope="col">Paid</th><th scope="col">Fees</th><th scope="col">Sent</th><th scope="col">Paid orders</th></tr>
+              </thead>
+              <tbody>
+                <tr v-for="p in h.practices.slice(0, shown)" :key="p.practice_name">
+                  <th scope="row">{{ p.practice_name }}</th>
+                  <td>{{ dollars(p.paid_cents) }}</td>
+                  <td>{{ dollars(p.fees_cents) }}</td>
+                  <td>{{ p.orders_sent }}</td>
+                  <td>{{ p.orders_paid }}</td>
+                </tr>
+              </tbody>
+            </table>
+            <button v-if="h.practices.length > shown" type="button" class="btn-secondary" @click="shown += 25">Show 25 more</button>
+            <p class="note">Totals only: single orders open in Paid orders.</p>
+            <p class="note">Questions? Contact platform support</p>
+          </div>
+        </template>
+      </template>
+    </section>
+  </AppShell>
+</template>
