+++ b/tests/unit/platform-health.test.ts
@@ -0,0 +1,29 @@
+// BE-16 PlatformHealthQueries, pure part (lld.md §2 Definitions, A-11; acceptance Q-4): the measures and their alert
+// lines. The SQL against the real tables is proved by tests/acceptance/M6/platform-health.test.ts (AT-001 to AT-009).
+import { describe, expect, it } from 'vitest'
+import { measures } from '../../server/services/platform-health'
+
+const base = { funnel: { sent: 10, checkout_started: 10, paid: 8, payment_failed: 1, checkout_expired: 1 }, median_minutes_to_pay: 1200, out_of_stock_refusals: 0, orders_needing_review: 0 }
+
+describe('BE-16 measures', () => {
+  it('sends the sent-to-paid rate as a percent with no alert line (Q-4) and every FR-048 measure once', () => {
+    const m = measures(base)
+    expect(m.find((x) => x.name === 'sent-to-paid rate')).toEqual({ name: 'sent-to-paid rate', value: 80, alert_line: null, needs_attention: false })
+    expect(m.map((x) => x.name)).toEqual(['sent-to-paid rate', 'median minutes to pay', 'failed payments', 'expired checkouts', 'out-of-stock refusals', 'orders needing review'])
+    expect(m.filter((x) => x.value === 80)).toHaveLength(1)
+  })
+
+  it('flags orders needing review at its alert line of 1 and above, never below (A-11, FR-049)', () => {
+    expect(measures(base).filter((x) => x.needs_attention)).toHaveLength(0)
+    for (const n of [1, 2]) {
+      const flagged = measures({ ...base, orders_needing_review: n }).filter((x) => x.needs_attention)
+      expect(flagged).toEqual([{ name: 'orders needing review', value: n, alert_line: 1, needs_attention: true }])
+    }
+  })
+
+  it('leaves out a measure with no value: no rate with nothing sent, no median with nothing paid', () => {
+    const m = measures({ funnel: { sent: 0, checkout_started: 0, paid: 0, payment_failed: 0, checkout_expired: 0 }, median_minutes_to_pay: null, out_of_stock_refusals: 0, orders_needing_review: 0 })
+    expect(m.map((x) => x.name)).toEqual(['failed payments', 'expired checkouts', 'out-of-stock refusals', 'orders needing review'])
+    expect(m.every((x) => typeof x.value === 'number')).toBe(true)
+  })
+})
diff --git a/tests/unit/request-metrics.test.ts b/tests/unit/request-metrics.test.ts
new file mode 100644
index 0000000..02825a2
--- /dev/null
+++ b/tests/unit/request-metrics.test.ts
@@ -0,0 +1,136 @@
+// BE-19 RequestMetrics, pure parts and FM-8 (lld.md §2, D87): route groups never carry ids, the availability window
+// counts 5-minute slots from the first ping ever, and a failed stats or ping write never rejects. The SQL against the
+// real tables is proved by tests/acceptance/M6/system-health.test.ts (AT-034 to AT-037).
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const fake = vi.hoisted(() => ({ fail: false, queries: [] as { sql: string; parameters: readonly unknown[] }[] }))
+vi.mock('../../server/utils/db', async () => {
+  const { Kysely, PostgresAdapter, PostgresIntrospector, PostgresQueryCompiler } = await import('kysely')
+  return {
+    useDb: () =>
+      new Kysely<any>({
+        dialect: {
+          createAdapter: () => new PostgresAdapter(),
+          createQueryCompiler: () => new PostgresQueryCompiler(),
+          createIntrospector: (db) => new PostgresIntrospector(db),
+          createDriver: () => ({
+            init: async () => {},
+            acquireConnection: async () => ({
+              executeQuery: async (q: { sql: string; parameters: readonly unknown[] }) => {
+                if (fake.fail) throw Object.assign(new Error('row (42, "Ana Patient") violates'), { code: '23514' })
+                fake.queries.push(q)
+                return { rows: [] }
+              },
+              streamQuery: () => {
+                throw new Error('not used')
+              },
+            }),
+            beginTransaction: async () => {},
+            commitTransaction: async () => {},
+            rollbackTransaction: async () => {},
+            releaseConnection: async () => {},
+            destroy: async () => {},
+          }),
+        },
+      }),
+  }
+})
+
+const { percent, record, recordPing, routeGroup, slotWindow } = await import('../../server/services/request-metrics')
+const { freezeClock } = await import('../../server/services/clock')
+
+afterEach(() => {
+  fake.fail = false
+  fake.queries = []
+  freezeClock(null)
+  vi.restoreAllMocks()
+})
+
+describe('routeGroup', () => {
+  it.each([
+    ['/api/orders/1042', 'api.orders'],
+    ['/api/orders/1042/payments?x=1', 'api.orders'],
+    ['/api/session', 'api.session'],
+    ['/api/ops/system-health?month=2025-10', 'api.ops'],
+    ['/patients/7/supplements', 'page.S1'],
+    ['/orders/1042', 'page.S2'],
+    ['/ops/orders', 'page.S3'],
+    ['/ops/orders/1042', 'page.S4'],
+    ['/sign-in?next=/ops/system', 'page.S8'],
+    ['/notices/abc123', 'page.S9'],
+    ['/ops/access-log', 'page.S13'],
+    ['/ops/system/', 'page.S14'],
+  ])('%s -> %s', (path, group) => {
+    expect(routeGroup(path)).toBe(group)
+  })
+
+  it.each(['/healthz', '/version', '/_nuxt/entry.js', '/', '/favicon.ico', '/api/ana-patient', '/api/', '/orders/1/extra'])(
+    'does not count %s',
+    (path) => {
+      expect(routeGroup(path)).toBeNull()
+    },
+  )
+})
+
+describe('slotWindow (D87)', () => {
+  const at = new Date('2026-10-11T12:07:30Z')
+  it('a past month pinged from its first instant has 31 × 288 slots', () => {
+    expect(slotWindow('2025-10', at, new Date('2025-10-01T00:00:00Z')).slots).toBe(8928)
+  })
+  it('starts at the first ping ever, truncated to its slot', () => {
+    const w = slotWindow('2025-10', at, new Date('2025-10-16T00:03:00Z'))
+    expect(w.from.toISOString()).toBe('2025-10-16T00:00:00.000Z')
+    expect(w.slots).toBe(16 * 288)
+  })
+  it('has no slots before the first ping or with no ping at all', () => {
+    expect(slotWindow('2025-09', at, new Date('2025-10-16T00:00:00Z')).slots).toBe(0)
+    expect(slotWindow('2025-10', at, null).slots).toBe(0)
+  })
+  it('the current month counts finished slots only', () => {
+    const w = slotWindow('2026-10', at, new Date('2026-01-01T00:00:00Z'))
+    expect(w.to.toISOString()).toBe('2026-10-11T12:05:00.000Z')
+    expect(w.slots).toBe(10 * 288 + 12 * 12 + 1)
+  })
+})
+
+describe('percent', () => {
+  it('is unrounded and null with a zero denominator', () => {
+    expect(percent(8901, 8928)).toBeCloseTo(99.6976, 3)
+    expect(percent(4, 1000)).toBe(0.4)
+    expect(percent(0, 0)).toBeNull()
+  })
+})
+
+describe('record and recordPing (FM-8)', () => {
+  it('upserts into the truncated hour and adds one error, one slow and one refusal', async () => {
+    freezeClock(new Date('2025-10-10T10:42:00Z'))
+    await record('api.orders', 503, 2500, true)
+    const q = fake.queries[0]!
+    expect(q.sql).toMatch(/insert into "request_stats".*on conflict \("hour", "route_group"\) do update set/)
+    expect(q.parameters.slice(0, 6)).toEqual([new Date('2025-10-10T10:00:00Z'), 'api.orders', 1, 1, 1, 1])
+  })
+
+  it('counts a fast 4xx as a request only', async () => {
+    await record('page.S4', 403, 2000, false)
+    expect(fake.queries[0]!.parameters.slice(2, 6)).toEqual([1, 0, 0, 0])
+  })
+
+  it('records the 5-minute slot once (on conflict do nothing)', async () => {
+    freezeClock(new Date('2025-10-10T10:44:59Z'))
+    await recordPing()
+    expect(fake.queries[0]!.sql).toMatch(/insert into "health_pings".*on conflict \("slot"\) do nothing/)
+    expect(fake.queries[0]!.parameters).toEqual([new Date('2025-10-10T10:40:00Z')])
+  })
+
+  it('a failed write resolves and logs only errorFacts', async () => {
+    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+    fake.fail = true
+    await expect(record('api.orders', 200, 5, false)).resolves.toBeUndefined()
+    await expect(recordPing()).resolves.toBeUndefined()
+    expect(warn.mock.calls).toEqual([
+      ['request stats write failed', { error: 'Error', code: '23514' }],
+      ['health ping write failed', { error: 'Error', code: '23514' }],
+    ])
+    expect(JSON.stringify(warn.mock.calls)).not.toContain('Ana')
+  })
+})
diff --git a/tests/unit/staff-access.test.ts b/tests/unit/staff-access.test.ts
new file mode 100644
index 0000000..1970da3
--- /dev/null
+++ b/tests/unit/staff-access.test.ts
@@ -0,0 +1,102 @@
+// BE-4 assertCanChangeRole and BE-18 changeRole, pure parts (lld.md §2, SEQ-10): who may change a role, the EP-37 body,
+// and the stale-role and last-finance-lead checks. The locked database path, the refused-row logging and the idempotent
+// replay are proved by tests/acceptance/M6/roles.test.ts (AT-018 to AT-029).
+import { describe, expect, it } from 'vitest'
+import { assertCanChangeRole } from '../../server/services/access-policy'
+import type { Role, Viewer } from '../../server/services/session'
+import { checkChange, RoleChangeRequest } from '../../server/services/staff-access'
+import { ProblemError } from '../../server/utils/problem'
+
+function problem(fn: () => unknown): ProblemError {
+  try {
+    fn()
+  } catch (e) {
+    if (e instanceof ProblemError) return e
+    throw e
+  }
+  throw new Error('expected a ProblemError')
+}
+
+const viewer = (userId: bigint, role: Role): Viewer => ({
+  userId,
+  displayName: 'Someone',
+  role,
+  practiceId: null,
+  practiceName: null,
+  idleExpiresAt: new Date(0),
+})
+
+describe('assertCanChangeRole', () => {
+  const omar = { id: 2n, role: 'operations_specialist' as Role, practiceId: null }
+
+  it('lets the SRE change someone else (AE-051)', () => {
+    expect(() => assertCanChangeRole(viewer(3n, 'sre'), omar)).not.toThrow()
+  })
+
+  it.each(['finance_lead', 'operations_specialist', 'data_analyst', 'none', 'provider', 'patient'] as Role[])(
+    'refuses a %s with forbidden (AE-052, FR-055)',
+    (role) => {
+      expect(problem(() => assertCanChangeRole(viewer(1n, role), omar)).slug).toBe('forbidden')
+    },
+  )
+
+  it('refuses the SRE on their own account with self-role-change (AE-053, FR-056)', () => {
+    expect(problem(() => assertCanChangeRole(viewer(3n, 'sre'), { id: 3n, role: 'sre', practiceId: null })).slug).toBe('self-role-change')
+  })
+
+  it('checks forbidden before self-role-change', () => {
+    expect(problem(() => assertCanChangeRole(viewer(1n, 'finance_lead'), { id: 1n, role: 'finance_lead', practiceId: null })).slug).toBe('forbidden')
+  })
+})
+
+describe('checkChange', () => {
+  const input = (role: string, expected_role: string, confirm_no_finance_lead = false) => ({ role, expected_role, confirm_no_finance_lead })
+
+  it('passes when the expected role is the current one', () => {
+    expect(() => checkChange('none', input('data_analyst', 'none'), 1)).not.toThrow()
+  })
+
+  it('refuses a stale expected role with the current role', () => {
+    const p = problem(() => checkChange('data_analyst', input('finance_lead', 'none'), 1))
+    expect(p.slug).toBe('stale-role')
+    expect(p.extensions).toEqual({ currentRole: 'data_analyst' })
+  })
+
+  it('refuses removing the last finance lead without the confirmation', () => {
+    expect(problem(() => checkChange('finance_lead', input('none', 'finance_lead'), 0)).slug).toBe('last-finance-lead')
+  })
+
+  it('allows removing the last finance lead with the confirmation', () => {
+    expect(() => checkChange('finance_lead', input('none', 'finance_lead', true), 0)).not.toThrow()
+  })
+
+  it('allows removing a finance lead while another remains', () => {
+    expect(() => checkChange('finance_lead', input('none', 'finance_lead'), 1)).not.toThrow()
+  })
+
+  it('does not apply the finance-lead rule when the finance lead keeps the role', () => {
+    expect(() => checkChange('finance_lead', input('finance_lead', 'finance_lead'), 0)).not.toThrow()
+  })
+})
+
+describe('RoleChangeRequest', () => {
+  const ok = { role: 'data_analyst', reason: 'new hire', expected_role: 'none' }
+
+  it('accepts a staff role, a reason up to 200 characters and any expected role', () => {
+    expect(RoleChangeRequest.safeParse(ok).success).toBe(true)
+    expect(RoleChangeRequest.safeParse({ ...ok, reason: 'y'.repeat(200) }).success).toBe(true)
+    expect(RoleChangeRequest.safeParse({ ...ok, expected_role: 'provider' }).success).toBe(true)
+    expect(RoleChangeRequest.parse(ok).confirm_no_finance_lead).toBe(false)
+  })
+
+  it.each([
+    ['an empty reason', { ...ok, reason: '' }],
+    ['a reason over 200 characters', { ...ok, reason: 'x'.repeat(201) }],
+    ['a non-staff role', { ...ok, role: 'provider' }],
+    ['an unknown expected role', { ...ok, expected_role: 'admin' }],
+    ['a missing expected role', { role: 'data_analyst', reason: 'new hire' }],
+    ['an unknown field', { ...ok, practice_id: 1 }],
+  ])('refuses %s', (_name, body) => {
+    expect(RoleChangeRequest.safeParse(body).success).toBe(false)
+  })
+})
