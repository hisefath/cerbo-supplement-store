+// BE-12 MessagingGateway (lld.md §2, SEAM-4): the stand-in notice is a row in `notices`. Its input has no field for
+// items, amounts or health details, so a notice can't carry them (FR-044, LINV-5).
+import { randomBytes } from 'node:crypto'
+import type { Kysely } from 'kysely'
+import { useDb } from '../utils/db'
+import type { Database } from '../utils/db-types'
+import { ProblemError } from '../utils/problem'
+
+export interface Notice {
+  practice_name: string
+  sign_in_path: string
+}
+
+/** Joins the caller's transaction when given one (sendOrder); a real send would happen after commit. */
+export async function sendOrderNotice(
+  input: { orderId: bigint; patientId: bigint; practiceId: bigint },
+  db: Kysely<Database> = useDb(),
+): Promise<{ token: string }> {
+  const token = randomBytes(32).toString('base64url')
+  await db
+    .insertInto('notices')
+    .values({ order_id: input.orderId, patient_id: input.patientId, practice_id: input.practiceId, token })
+    .execute()
+  return { token }
+}
+
+export async function getNotice(token: string): Promise<Notice> {
+  const row = await useDb()
+    .selectFrom('notices')
+    .innerJoin('practices', 'practices.id', 'notices.practice_id')
+    .select(['practices.name', 'notices.order_id'])
+    .where('notices.token', '=', token)
+    .executeTakeFirst()
+  if (!row) throw new ProblemError('not-found')
+  return { practice_name: row.name, sign_in_path: `/sign-in?next=/orders/${row.order_id}` }
+}
diff --git a/server/services/money.ts b/server/services/money.ts
new file mode 100644
index 0000000..6d6ac17
--- /dev/null
+++ b/server/services/money.ts
@@ -0,0 +1,79 @@
+// BE-6 Money (lld.md §2): every money calculation in whole cents with one rounding rule. Pure, no I/O.
+// Also imported by the order builder (FE-4) so its live totals use the same rule.
+
+export interface Split {
+  amountPaidCents: number
+  itemCostCents: number
+  providerPayoutCents: number
+  platformFeeCents: number
+}
+
+export class SplitMismatch extends Error {
+  constructor(public readonly split: Split) {
+    super('split does not balance')
+  }
+}
+
+/** 0.75% of the amount, rounded half-up once: (amount × 75 + 5000) ÷ 10000, floored (FR-011). */
+export function platformFeeCents(amountPaidCents: number): number {
+  return Math.floor((amountPaidCents * 75 + 5000) / 10000)
+}
+
+/** amount − cost − fee (FR-012). May be negative; callers check the floor. */
+export function payoutCents(amountPaidCents: number, itemCostCents: number, feeCents: number): number {
+  return amountPaidCents - itemCostCents - feeCents
+}
+
+/** Each line's share of the order's one fee, proportional; leftover cents go to the largest remainders, ties to the
+ *  earlier line. Sums to feeCents exactly (FR-028, Q-2). */
+export function allocateFee(lineAmountsCents: number[], feeCents: number): number[] {
+  const total = lineAmountsCents.reduce((a, b) => a + b, 0)
+  if (total === 0) return lineAmountsCents.map(() => 0)
+  const shares = lineAmountsCents.map((a) => Math.floor((a * feeCents) / total))
+  let left = feeCents - shares.reduce((a, b) => a + b, 0)
+  const order = lineAmountsCents
+    .map((a, i) => ({ i, rem: (a * feeCents) % total }))
+    .sort((x, y) => y.rem - x.rem || x.i - y.i)
+  for (const { i } of order) {
+    if (left <= 0) break
+    shares[i] = shares[i]! + 1
+    left -= 1
+  }
+  return shares
+}
+
+/** Cost plus a 50% margin of the price, i.e. 2 × cost (FR-017). */
+export function defaultPriceCents(unitCostCents: number): number {
+  return unitCostCents * 2
+}
+
+/** cost ÷ (1 − margin), rounded half-up to a cent (FR-018). Margin in basis points (5000 = 50%). */
+export function priceFromMargin(unitCostCents: number, marginBasisPoints: number): number {
+  const d = 10000 - marginBasisPoints
+  return Math.floor((2 * unitCostCents * 10000 + d) / (2 * d))
+}
+
+/** The smallest price whose payout on one unit after its fee is ≥ 0 (FR-020). */
+export function lowestAllowedPriceCents(unitCostCents: number): number {
+  let p = unitCostCents
+  while (payoutCents(p, unitCostCents, platformFeeCents(p)) < 0) p += 1
+  return p
+}
+
+/** The unit cost behind a lowest allowed price: the payout at the floor is exactly $0.00, because the payout grows
+ *  by at most one cent per cent of price. Lets the order builder show the payout live from the Catalog (SEQ-1 step 5),
+ *  which carries the floor but not the cost. */
+export function unitCostFromLowestAllowedPrice(lowestAllowedCents: number): number {
+  return lowestAllowedCents - platformFeeCents(lowestAllowedCents)
+}
+
+/** Refuses a split that is not whole cents or does not add up (FR-013). */
+export function assertSplitBalances(split: Split): void {
+  const parts = [split.amountPaidCents, split.itemCostCents, split.providerPayoutCents, split.platformFeeCents]
+  if (
+    !parts.every(Number.isInteger) ||
+    split.amountPaidCents !== split.itemCostCents + split.providerPayoutCents + split.platformFeeCents
+  ) {
+    throw new SplitMismatch(split)
+  }
+}
diff --git a/server/services/orders.ts b/server/services/orders.ts
new file mode 100644
index 0000000..ef32060
--- /dev/null
+++ b/server/services/orders.ts
@@ -0,0 +1,113 @@
+// BE-9 OrderService (lld.md §2, SEQ-1, SM-1): send an order. Later tasks add show, checkout and cancel here.
+import { useDb } from '../utils/db'
+import { ProblemError } from '../utils/problem'
+import { assertCanActOnPatient } from './access-policy'
+import { currentPrices, loadPatient } from './catalog'
+import { sendOrderNotice } from './messaging'
+import { payoutCents, platformFeeCents } from './money'
+import type { Viewer } from './session'
+
+export interface SendOrderInput {
+  patientId: bigint
+  lines: { productId: bigint; quantity: number }[]
+}
+
+export interface OrderLine {
+  product_id: number
+  name: string
+  quantity: number
+  unit_price_cents: number
+  line_total_cents: number
+}
+
+export interface Order {
+  order_id: number
+  status: string
+  lines: OrderLine[]
+  total_cents: number
+  platform_fee_cents: number
+  provider_payout_cents: number
+  sent_at: string
+}
+
+export async function sendOrder(viewer: Viewer, input: SendOrderInput): Promise<Order> {
+  const patient = await loadPatient(input.patientId)
+  assertCanActOnPatient(viewer, patient)
+  const practiceId = patient.practiceId!
+
+  // One line per product, quantities added (LINV-4).
+  const quantities = new Map<bigint, number>()
+  for (const l of input.lines) quantities.set(l.productId, (quantities.get(l.productId) ?? 0) + l.quantity)
+  if (quantities.size === 0) throw new ProblemError('validation', { errors: [{ pointer: '#/lines', detail: 'Add at least one supplement.' }] })
+  const productIds = [...quantities.keys()]
+
+  const db = useDb()
+  const products = await db
+    .selectFrom('products')
+    .select(['id', 'name', 'unit_cost_cents', 'units_in_stock'])
+    .where('id', 'in', productIds.map(String))
+    .execute()
+  const byId = new Map(products.map((p) => [BigInt(p.id), p]))
+  const unknown = productIds.filter((id) => !byId.has(id))
+  if (unknown.length > 0) {
+    throw new ProblemError('validation', {
+      errors: unknown.map((id) => ({ pointer: '#/lines', detail: `Product ${id} does not exist.` })),
+    })
+  }
+  const short = productIds.filter((id) => quantities.get(id)! > byId.get(id)!.units_in_stock)
+  if (short.length > 0) {
+    throw new ProblemError('insufficient-stock', {
+      productIds: short.map(Number),
+      unitsAvailable: short.map((id) => byId.get(id)!.units_in_stock),
+    })
+  }
+  const prices = await currentPrices(practiceId, productIds)
+
+  const lines = productIds.map((id) => {
+    const p = byId.get(id)!
+    const quantity = quantities.get(id)!
+    const unit = prices.get(id)!
+    return { id, name: p.name, quantity, unit, total: unit * quantity, cost: p.unit_cost_cents * quantity }
+  })
+  const total = lines.reduce((s, l) => s + l.total, 0)
+  const cost = lines.reduce((s, l) => s + l.cost, 0)
+  const fee = platformFeeCents(total)
+
+  const order = await db.transaction().execute(async (trx) => {
+    const o = await trx
+      .insertInto('orders')
+      .values({ practice_id: practiceId, provider_id: viewer.userId, patient_id: input.patientId, status: 'sent' })
+      .returning(['id', 'status', 'sent_at'])
+      .executeTakeFirstOrThrow()
+    await trx
+      .insertInto('order_lines')
+      .values(
+        lines.map((l) => ({
+          order_id: o.id,
+          product_id: l.id,
+          product_name: l.name,
+          quantity: l.quantity,
+          sent_unit_price_cents: l.unit,
+        })),
+      )
+      .execute()
+    await sendOrderNotice({ orderId: BigInt(o.id), patientId: input.patientId, practiceId }, trx)
+    return o
+  })
+
+  return {
+    order_id: Number(order.id),
+    status: order.status,
+    lines: lines.map((l) => ({
+      product_id: Number(l.id),
+      name: l.name,
+      quantity: l.quantity,
+      unit_price_cents: l.unit,
+      line_total_cents: l.total,
+    })),
+    total_cents: total,
+    platform_fee_cents: fee,
+    provider_payout_cents: payoutCents(total, cost, fee),
+    sent_at: order.sent_at.toISOString(),
+  }
+}
diff --git a/server/services/session.ts b/server/services/session.ts
new file mode 100644
index 0000000..d207577
--- /dev/null
+++ b/server/services/session.ts
@@ -0,0 +1,143 @@
+// BE-3 SessionService (lld.md §2, SEQ-7): server-side sessions with a 15-minute idle limit (NFR-008, D37).
+// Passwords: scrypt$<N>$<r>$<p>$<salt b64>$<hash b64> (Q-1); the stored value carries its own cost (SEAM-6).
+import { createHash, randomBytes, scrypt, timingSafeEqual } from 'node:crypto'
+import { promisify } from 'node:util'
+import { getCookie, setCookie, type H3Event } from 'h3'
+import { sql } from 'kysely'
+import { useDb } from '../utils/db'
+import { ProblemError } from '../utils/problem'
+
+export type Role = 'patient' | 'provider' | 'finance_lead' | 'operations_specialist' | 'sre' | 'data_analyst' | 'none'
+
+export interface Viewer {
+  userId: bigint
+  displayName: string
+  role: Role
+  practiceId: bigint | null
+  idleExpiresAt: Date
+}
+
+export const SESSION_COOKIE = 'session'
+const IDLE_MS = 15 * 60 * 1000
+
+const scryptAsync = promisify(scrypt) as (
+  password: string,
+  salt: Buffer,
+  keylen: number,
+  options: { N: number; r: number; p: number; maxmem: number },
+) => Promise<Buffer>
+
+const hashToken = (token: string): Buffer => createHash('sha256').update(token).digest()
+
+// Compared against when the email is unknown, so both cases take about the same time.
+const DUMMY_HASH = `scrypt$1024$8$1$${Buffer.alloc(16).toString('base64')}$${Buffer.alloc(64).toString('base64')}`
+
+async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const [scheme, n, r, p, salt, hash] = stored.split('$')
+  if (scheme !== 'scrypt' || !salt || !hash) return false
+  const N = Number(n)
+  const R = Number(r)
+  const expected = Buffer.from(hash, 'base64')
+  try {
+    const actual = await scryptAsync(password, Buffer.from(salt, 'base64'), expected.length, {
+      N,
+      r: R,
+      p: Number(p),
+      maxmem: 256 * N * R,
+    })
+    return timingSafeEqual(actual, expected)
+  } catch {
+    return false // malformed stored value
+  }
+}
+
+function toViewer(u: { id: string; display_name: string; role: string; practice_id: string | null }, lastSeen: Date): Viewer {
+  return {
+    userId: BigInt(u.id),
+    displayName: u.display_name,
+    role: u.role as Role,
+    practiceId: u.practice_id === null ? null : BigInt(u.practice_id),
+    idleExpiresAt: new Date(lastSeen.getTime() + IDLE_MS),
+  }
+}
+
+// ponytail: no sign-in rate limit yet (lld §4 says 10 tries / 15 min per email or address); no table holds the
+// counts and counting every attempt would refuse the acceptance suite's repeated sign-ins. See result.md Questions.
+export async function signIn(email: string, password: string, _ip: string): Promise<{ viewer: Viewer; cookieToken: string }> {
+  const db = useDb()
+  const user = await db
+    .selectFrom('users')
+    .select(['id', 'display_name', 'role', 'practice_id', 'password_hash'])
+    .where(sql`lower(email)`, '=', email.toLowerCase())
+    .executeTakeFirst()
+  const ok = await verifyPassword(password, user?.password_hash ?? DUMMY_HASH)
+  if (!user || !ok) throw new ProblemError('sign-in-failed')
+  const cookieToken = randomBytes(32).toString('base64url')
+  const s = await db
+    .insertInto('sessions')
+    .values({ token_hash: hashToken(cookieToken), user_id: user.id })
+    .returning('last_seen_at')
+    .executeTakeFirstOrThrow()
+  return { viewer: toViewer(user, s.last_seen_at), cookieToken }
+}
+
+/** The viewer, after moving last_seen_at forward; null when missing, ended or idle 15 minutes or more. */
+export async function resolve(cookieToken: string | undefined): Promise<Viewer | null> {
+  if (!cookieToken) return null
+  const db = useDb()
+  const tokenHash = hashToken(cookieToken)
+  const live = await db
+    .updateTable('sessions')
+    .set({ last_seen_at: sql`now()` })
+    .where('token_hash', '=', tokenHash)
+    .where('ended_at', 'is', null)
+    .where('last_seen_at', '>', sql<Date>`now() - interval '15 minutes'`)
+    .returning(['user_id', 'last_seen_at'])
+    .executeTakeFirst()
+  if (!live) {
+    await db
+      .updateTable('sessions')
+      .set({ ended_at: sql`now()` })
+      .where('token_hash', '=', tokenHash)
+      .where('ended_at', 'is', null)
+      .execute()
+    return null
+  }
+  const user = await db
+    .selectFrom('users')
+    .select(['id', 'display_name', 'role', 'practice_id'])
+    .where('id', '=', live.user_id)
+    .executeTakeFirstOrThrow()
+  return toViewer(user, live.last_seen_at)
+}
+
+export async function signOut(cookieToken: string): Promise<void> {
+  await useDb()
+    .updateTable('sessions')
+    .set({ ended_at: sql`now()` })
+    .where('token_hash', '=', hashToken(cookieToken))
+    .where('ended_at', 'is', null)
+    .execute()
+}
+
+export function setSessionCookie(event: H3Event, cookieToken: string): void {
+  setCookie(event, SESSION_COOKIE, cookieToken, { httpOnly: true, secure: true, sameSite: 'lax', path: '/' })
+}
+
+/** The signed-in viewer, or 401 /problems/unauthenticated. */
+export async function requireViewer(event: H3Event): Promise<Viewer> {
+  const viewer = await resolve(getCookie(event, SESSION_COOKIE))
+  if (!viewer) throw new ProblemError('unauthenticated')
+  return viewer
+}
+
+/** The Me schema (openapi.yaml). */
+export function toMe(v: Viewer) {
+  return {
+    user_id: Number(v.userId),
+    display_name: v.displayName,
+    role: v.role,
+    practice_id: v.practiceId === null ? null : Number(v.practiceId),
+    idle_expires_at: v.idleExpiresAt.toISOString(),
+  }
+}
