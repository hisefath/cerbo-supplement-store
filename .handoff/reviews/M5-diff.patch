+
+  it('M5_AT_042 Pay pressed after the 30-minute hold ended answers 409 checkout-expired, not invalid-transition; nothing is charged or reserved (lld.md /problems/checkout-expired, SM-1, FR-037)', async () => {
+    const w = app.world()
