diff --git a/app/pages/practice/dashboard.vue b/app/pages/practice/dashboard.vue
new file mode 100644
index 0000000..e3b3109
--- /dev/null
+++ b/app/pages/practice/dashboard.vue
@@ -0,0 +1,235 @@
+<!-- FE-15 PracticeDashboardPage (S6, SEQ-5): attention items first, then the month's orders (EP-30, 25 at a time,
+     Cancel order calls EP-20), then sales and stock (EP-29). Owns ST-7 (the month, UTC per Q-3), ST-12 (the order
+     being cancelled) and ST-8 (each section's load state). -->
+<script setup lang="ts">
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface AttentionItem { kind: 'awaiting_payment' | 'low_stock' | 'out_of_stock'; label: string; order_id: number | null; product_id: number | null }
+interface ProductSales { product_id: number; name: string; units_sold: number; patients_paid_cents: number; provider_payout_cents: number; units_in_stock: number }
+interface PracticeDashboard { month: string; attention: AttentionItem[]; sales: ProductSales[] }
+interface PracticeOrder { order_id: number; patient_display_name: string; total_cents: number; status: string; sent_at: string; paid_at: string | null }
+interface PracticeOrderPage { data: PracticeOrder[]; next_cursor: string | null }
+
+// S6 names the practice, but no EP returns its name yet (Me has only practice_id): this reads the session's
+// practice_name if EP-17 ever returns it, and falls back to the bare title until then (question in M5-T010 result).
+const viewer = useNuxtData<{ practice_name?: string } | null>('viewer').data
+const practiceName = computed(() => viewer.value?.practice_name ?? '')
+useHead({ title: computed(() => (practiceName.value ? `Practice dashboard · ${practiceName.value}` : 'Practice dashboard')) })
+
+const thisMonth = new Date().toISOString().slice(0, 7)
+const month = ref(thisMonth) // ST-7; the month input can be cleared, which the server reads as this month
+const shownMonth = computed(() => month.value || thisMonth)
+const monthName = computed(() =>
+  new Date(`${shownMonth.value}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
+)
+
+const dash = await useFetch<PracticeDashboard>('/api/practice/dashboard', { query: { month: shownMonth } }) // ST-8
+const list = await useFetch<PracticeOrderPage>('/api/practice/orders', { query: { month: shownMonth } })
+const more = ref<PracticeOrder[]>([])
+const nextCursor = ref<string | null>(null)
+const loadingMore = ref(false)
+let listGen = 0 // bumps when the month or the first page changes, so a late Show 25 more page is dropped
+watch(shownMonth, () => listGen++)
+watch(list.data, (p) => {
+  listGen++
+  more.value = []
+  nextCursor.value = p?.next_cursor ?? null
+}, { immediate: true })
+const orders = computed(() => [...(list.data.value?.data ?? []), ...more.value])
+const moreProblem = ref<Problem | null>(null)
+
+async function showMore() {
+  if (!nextCursor.value || loadingMore.value) return
+  const gen = listGen
+  loadingMore.value = true
+  try {
+    const page = await $fetch<PracticeOrderPage>('/api/practice/orders', { query: { month: shownMonth.value, cursor: nextCursor.value } })
+    if (gen !== listGen) return
+    more.value.push(...page.data)
+    nextCursor.value = page.next_cursor
+    moreProblem.value = null
+  } catch (e: unknown) {
+    if (gen === listGen) moreProblem.value = (e as { data?: Problem }).data ?? { type: '/problems/internal' }
+  } finally {
+    loadingMore.value = false
+  }
+}
+
+// S6 Loading: "Loading <month>…", then after 10 s "Still loading. Stock counts appear first."
+const pending = computed(() => dash.status.value === 'pending' || list.status.value === 'pending')
+const slow = ref(false)
+let slowTimer: ReturnType<typeof setTimeout> | undefined
+watch(pending, (p) => {
+  clearTimeout(slowTimer)
+  slow.value = false
+  if (p) slowTimer = setTimeout(() => (slow.value = true), 10_000)
+})
+onBeforeUnmount(() => clearTimeout(slowTimer))
+
+const dollars = (c: number) => `$${(c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
+const when = (iso: string | null) =>
+  iso ? new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }) : '-'
+const STATUS: Record<string, string> = {
+  sent: 'Sent',
+  in_checkout: 'In checkout',
+  payment_failed: 'Payment failed',
+  paid: 'Paid',
+  needs_review: 'Needs review',
+  cancelled: 'Cancelled',
+}
+
+/** S6: "Ben Ortiz · $30.00 · awaiting payment for 4 days" and "Omega-3 Fish Oil · low stock: 3 left". */
+function attentionText(a: AttentionItem): string {
+  if (a.kind === 'out_of_stock') return a.label
+  const order = a.order_id === null ? undefined : orders.value.find((o) => o.order_id === a.order_id)
+  const product = dash.data.value?.sales.find((s) => s.product_id === a.product_id)
+  const who = order ? `${order.patient_display_name} · ${dollars(order.total_cents)} · ` : product ? `${product.name} · ` : a.order_id ? `Order ${a.order_id} · ` : ''
+  return who + a.label
+}
+
+// ST-12: the order whose cancellation is being confirmed.
+const cancelling = ref<PracticeOrder | null>(null)
+const busy = ref(false)
+const success = ref('')
+const rowProblem = ref<{ id: number; problem: Problem } | null>(null)
+
+async function confirmCancel() {
+  const o = cancelling.value
+  if (!o || busy.value) return
+  busy.value = true
+  try {
+    await $fetch(`/api/orders/${o.order_id}/cancel`, { method: 'POST' })
+    success.value = `Order ${o.order_id} cancelled. ${o.patient_display_name} will see that your practice cancelled it.`
+    rowProblem.value = null
+    cancelling.value = null
+    await Promise.all([list.refresh(), dash.refresh()])
+  } catch (e: unknown) {
+    rowProblem.value = { id: o.order_id, problem: (e as { data?: Problem }).data ?? { type: '/problems/internal' } }
+    cancelling.value = null
+  } finally {
+    busy.value = false
+  }
+}
+
+const cancelCopy = computed(() => {
+  const o = orders.value.find((x) => x.order_id === rowProblem.value?.id)
+  return {
+    'invalid-transition': o?.status === 'paid' ? "This order is paid, so it can't be cancelled." : "This order can't be cancelled: the patient has started checkout.",
+    internal: "We couldn't cancel the order. It is unchanged. Try again.",
+  }
+})
+const problemOf = (e: unknown): Problem | null => (e ? ((e as { data?: Problem }).data ?? { type: '/problems/internal' }) : null)
+const forbiddenCopy = computed(() => ({ forbidden: `Only providers at ${practiceName.value || 'this practice'} can see this dashboard.` }))
+
+// S6 Accessibility: the confirmation dialog keeps focus until Cancel order or Keep order.
+const dialog = ref<HTMLElement | null>(null)
+const dialogButtons = () => [...(dialog.value?.querySelectorAll('button') ?? [])].filter((b) => !b.disabled)
+const focusKeep = () => dialog.value?.querySelector<HTMLButtonElement>('.keep')?.focus()
+watch(cancelling, async (o) => {
+  if (!o) return
+  await nextTick()
+  focusKeep()
+})
+function trapTab(e: KeyboardEvent) {
+  if (e.key !== 'Tab') return
+  const b = dialogButtons()
+  const at = b.indexOf(document.activeElement as HTMLButtonElement)
+  e.preventDefault()
+  b[(at + (e.shiftKey ? b.length - 1 : 1)) % b.length]?.focus()
+}
+function holdFocus(e: FocusEvent) {
+  if (cancelling.value && !dialog.value?.contains(e.relatedTarget as Node | null)) setTimeout(focusKeep)
+}
+</script>
+
+<template>
+  <AppShell>
+    <section class="dashboard" aria-labelledby="dashboard-heading">
+      <h1 id="dashboard-heading">{{ practiceName ? `Practice dashboard · ${practiceName}` : 'Practice dashboard' }}</h1>
+      <label class="month">Month <input v-model="month" type="month" required></label>
+      <p role="status">{{ pending ? (slow ? 'Still loading. Stock counts appear first.' : `Loading ${monthName}…`) : `Showing ${monthName}.` }} Times in UTC.</p>
+      <p class="success" role="status">{{ success }}</p>
+
+      <h2>Needs attention</h2>
+      <ProblemMessage v-if="dash.error.value" :problem="problemOf(dash.error.value)" :copy="forbiddenCopy" @retry="dash.refresh()" />
+      <template v-else-if="dash.data.value">
+        <p v-if="dash.data.value.attention.length === 0">Nothing needs attention.</p>
+        <ul v-else class="attention">
+          <li v-for="(a, i) in dash.data.value.attention" :key="i"><span aria-hidden="true">! </span>{{ attentionText(a) }}</li>
+        </ul>
+      </template>
+
+      <h2>Orders</h2>
+      <ProblemMessage
+        v-if="list.error.value"
+        :problem="problemOf(list.error.value)"
+        :copy="{ ...forbiddenCopy, internal: 'We couldn\'t load your orders. Try again.' }"
+        @retry="list.refresh()"
+      />
+      <template v-else-if="list.data.value">
+        <p v-if="orders.length === 0">{{ shownMonth === thisMonth ? "No orders yet. Send one from a patient's chart." : `No orders were sent in ${monthName}.` }}</p>
+        <table v-else class="list">
+          <thead>
+            <tr><th scope="col">Patient</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Sent</th><th scope="col">Paid</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
+          </thead>
+          <tbody>
+            <tr v-for="o in orders" :key="o.order_id">
+              <td>{{ o.patient_display_name }}</td>
+              <td>{{ dollars(o.total_cents) }}</td>
+              <td>{{ STATUS[o.status] ?? o.status }}</td>
+              <td>{{ when(o.sent_at) }}</td>
+              <td>{{ when(o.paid_at) }}</td>
+              <td>
+                <button v-if="o.status === 'sent' || o.status === 'payment_failed'" type="button" @click="cancelling = o">Cancel order</button>
+                <ProblemMessage v-if="rowProblem?.id === o.order_id" :problem="rowProblem.problem" :copy="cancelCopy" @retry="cancelling = o" />
+              </td>
+            </tr>
+          </tbody>
+        </table>
+        <button v-if="nextCursor" type="button" @click="showMore">Show 25 more</button>
+        <ProblemMessage v-if="moreProblem" :problem="moreProblem" :copy="{ internal: 'We couldn\'t load your orders. Try again.' }" @retry="showMore" />
+      </template>
+
+      <h2>Sales and stock</h2>
+      <table v-if="dash.data.value" class="list">
+        <thead>
+          <tr><th scope="col">Product</th><th scope="col">Sold</th><th scope="col">Patients paid</th><th scope="col">Your payout</th><th scope="col">Stock</th></tr>
+        </thead>
+        <tbody>
+          <tr v-for="s in dash.data.value.sales" :key="s.product_id">
+            <td>{{ s.name }}</td>
+            <td>{{ s.units_sold }}</td>
+            <td>{{ dollars(s.patients_paid_cents) }}</td>
+            <td>{{ dollars(s.provider_payout_cents) }}</td>
+            <td>{{ s.units_in_stock === 0 ? 'Out of stock' : s.units_in_stock }}</td>
+          </tr>
+        </tbody>
+      </table>
+      <p>Questions? Contact platform support</p>
+
+      <div v-if="cancelling" ref="dialog" role="dialog" aria-modal="true" aria-labelledby="cancel-heading" class="dialog" @keydown="trapTab" @focusout="holdFocus">
+        <p id="cancel-heading">
+          Cancel {{ cancelling.patient_display_name }}'s {{ dollars(cancelling.total_cents) }} order?
+          {{ cancelling.patient_display_name.split(' ')[0] }} will see that your practice cancelled it. This can't be undone.
+        </p>
+        <button type="button" :disabled="busy" @click="confirmCancel">{{ busy ? 'Cancelling…' : 'Cancel order' }}</button>
+        <button type="button" class="keep" @click="cancelling = null">Keep order</button>
+      </div>
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.list { width: 100%; border-collapse: collapse; }
+.list th, .list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #ddd; overflow-wrap: anywhere; }
+button { min-height: 24px; min-width: 24px; }
+.attention { list-style: none; padding: 0; }
+.attention li { padding: 4px 0; }
+.dialog { border: 1px solid #999; padding: 12px; background: #fff; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
+@media (max-width: 600px) {
+  .list thead { display: none; }
+  .list tr { display: block; border: 1px solid #ddd; margin-bottom: 8px; padding: 4px; }
+  .list td { display: block; border: 0; padding: 2px 4px; }
+}
+</style>
diff --git a/app/pages/practice/prices.vue b/app/pages/practice/prices.vue
new file mode 100644
index 0000000..f73f45f
--- /dev/null
+++ b/app/pages/practice/prices.vue
@@ -0,0 +1,190 @@
+<!-- FE-13 PracticePricesPage (S5, EP-7): this practice's prices (EP-27), the change dialog (FE-14, EP-28) and the
+     permanent price history. Owns ST-6, the change draft, and one Idempotency-Key per save, kept for its retries. -->
+<script setup lang="ts">
+import type { DraftErrors, PracticePrice, PriceDraft } from '~/components/practice-prices/PriceChangeDialog.vue'
+import { fieldErrors, toHundredths } from '~/components/practice-prices/PriceChangeDialog.vue'
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface PriceChange {
+  product_name: string
+  changed_by_display_name: string
+  changed_at: string
+  old_price_cents: number
+  new_price_cents: number
+  reason: string
+}
+interface PriceList {
+  prices: PracticePrice[]
+  history: PriceChange[]
+  history_next_cursor: string | null
+}
+
+useHead({ title: 'Practice prices' })
+const route = useRoute()
+const cursor = computed(() => (typeof route.query.history_cursor === 'string' ? route.query.history_cursor : undefined))
+const { data: list, error, refresh, status } = await useFetch<PriceList>('/api/practice/prices', {
+  query: { history_cursor: cursor },
+}) // ST-8
+
+const editing = ref<PracticePrice | null>(null)
+const draft = ref<PriceDraft>({ mode: 'price', price: '', margin: '', reason: '' }) // ST-6
+const errors = ref<DraftErrors>({})
+const key = ref<string | null>(null)
+const saving = ref(false)
+const slow = ref(false)
+const success = ref('')
+
+const dollars = (c: number) => `$${(c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
+const percent = (bp: number) => `${(bp / 100).toFixed(bp % 100 === 0 ? 0 : 2)}%`
+const when = (iso: string) =>
+  new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
+
+function open(p: PracticePrice) {
+  editing.value = p
+  draft.value = { mode: 'price', price: (p.price_cents / 100).toFixed(2), margin: '', reason: '' }
+  errors.value = {}
+  key.value = null
+  success.value = ''
+}
+function close() {
+  const id = editing.value?.product_id
+  editing.value = null
+  nextTick(() => document.getElementById(`change-${id}`)?.focus())
+}
+function onChange(d: PriceDraft) {
+  draft.value = d
+  key.value = null // a different request needs its own key
+}
+
+async function save() {
+  const p = editing.value
+  if (!p || saving.value) return
+  const value = toHundredths(draft.value.mode === 'price' ? draft.value.price : draft.value.margin)
+  const next: DraftErrors = {}
+  if (value === null || (draft.value.mode === 'margin' && value > 9999)) {
+    next.price = draft.value.mode === 'price' ? 'Enter a price in dollars, like 37.50.' : 'Enter a margin from 0 to 99.99.'
+  }
+  if (draft.value.reason.trim() === '') next.reason = 'Add a reason so others know why the price changed.'
+  errors.value = next
+  if (next.price || next.reason) return
+
+  saving.value = true
+  const timer = setTimeout(() => (slow.value = true), 10_000)
+  key.value ??= crypto.randomUUID()
+  try {
+    const saved = await $fetch<PracticePrice>(`/api/practice/prices/${p.product_id}`, {
+      method: 'PUT',
+      headers: { 'idempotency-key': key.value },
+      body: {
+        ...(draft.value.mode === 'price' ? { price_cents: value } : { margin_basis_points: value }),
+        reason: draft.value.reason.trim(),
+        expected_current_price_cents: p.price_cents,
+      },
+    })
+    success.value = `${saved.name} is now ${dollars(saved.price_cents)}. Orders not yet in checkout will show the new price.`
+    close()
+    await refresh()
+  } catch (e: unknown) {
+    const data = (e as { data?: Problem & { currentPriceCents?: number; changedBy?: string | null } }).data
+    const slug = data?.type?.replace('/problems/', '')
+    if (slug === 'below-price-floor') {
+      const floor = dollars(data!.lowestAllowedPriceCents ?? p.lowest_allowed_price_cents)
+      errors.value = { price: `That price is below the lowest allowed, ${floor}. Enter ${floor} or more.` }
+    } else if (slug === 'stale-price') {
+      const who = data!.changedBy ?? 'Someone'
+      errors.value = { form: `${who} changed this price to ${dollars(data!.currentPriceCents ?? p.price_cents)} a moment ago. Check it before saving yours.` }
+      await refresh()
+      editing.value = list.value?.prices.find((x) => x.product_id === p.product_id) ?? p
+    } else if (slug === 'validation') {
+      errors.value = fieldErrors((data as { errors?: { pointer: string; detail: string }[] }).errors, p.lowest_allowed_price_cents)
+    } else if (!navigator.onLine) {
+      errors.value = { form: "You're offline. The old price still applies." }
+    } else {
+      errors.value = { form: "We couldn't save the new price. The old price still applies. Try again." }
+    }
+  } finally {
+    clearTimeout(timer)
+    saving.value = false
+    slow.value = false
+  }
+}
+const pageProblem = computed<Problem | null>(() => (error.value ? (error.value.data as Problem) ?? { type: '/problems/internal' } : null))
+</script>
+
+<template>
+  <AppShell>
+    <section class="prices" aria-labelledby="prices-heading">
+      <h1 id="prices-heading">Practice prices</h1>
+      <p v-if="status === 'pending' && !list" role="status">Loading prices…</p>
+      <ProblemMessage
+        v-else-if="pageProblem"
+        :problem="pageProblem"
+        :copy="{ forbidden: 'Only providers at this practice can change its prices.' }"
+        @retry="refresh()"
+      />
+      <template v-else-if="list">
+        <p class="success" role="status">{{ success }}</p>
+        <table class="list">
+          <thead>
+            <tr>
+              <th scope="col">Product</th><th scope="col">Cost</th><th scope="col">Price</th><th scope="col">Margin</th>
+              <th scope="col">Set by</th><th scope="col"><span class="visually-hidden">Actions</span></th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr v-for="p in list.prices" :key="p.product_id">
+              <td>{{ p.name }}</td>
+              <td>{{ dollars(p.unit_cost_cents) }}</td>
+              <td>{{ dollars(p.price_cents) }}</td>
+              <td>{{ percent(p.margin_basis_points) }}</td>
+              <td>{{ p.is_default ? 'Default' : p.set_by_display_name }}</td>
+              <td>
+                <button :id="`change-${p.product_id}`" type="button" :aria-label="`Change price for ${p.name}`" @click="open(p)">
+                  Change price
+                </button>
+              </td>
+            </tr>
+          </tbody>
+        </table>
+
+        <h2>Price history</h2>
+        <p v-if="list.history.length === 0 && !cursor">No changes yet. Every price is the default.</p>
+        <ul v-else class="history">
+          <li v-for="(h, i) in list.history" :key="i">
+            <span>{{ when(h.changed_at) }}</span> <span>{{ h.changed_by_display_name }}</span> <span>{{ h.product_name }}</span>
+            <span>{{ dollars(h.old_price_cents) }} to {{ dollars(h.new_price_cents) }}</span>
+            <q>{{ h.reason }}</q>
+          </li>
+        </ul>
+        <NuxtLink v-if="list.history_next_cursor" :to="{ query: { history_cursor: list.history_next_cursor } }">Show 25 more</NuxtLink>
+      </template>
+
+      <PracticePricesPriceChangeDialog
+        v-if="editing"
+        :price="editing"
+        :draft="draft"
+        :errors="errors"
+        :saving="saving"
+        :slow="slow"
+        @change="onChange"
+        @save="save"
+        @cancel="close"
+      />
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.list { width: 100%; border-collapse: collapse; }
+.list th, .list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #ddd; overflow-wrap: anywhere; }
+.list button { min-height: 24px; min-width: 24px; }
+.history { list-style: none; padding: 0; }
+.history li { padding: 6px 0; border-bottom: 1px solid #eee; display: flex; flex-wrap: wrap; gap: 8px; }
+.history q { flex-basis: 100%; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
+@media (max-width: 600px) {
+  .list thead { display: none; }
+  .list tr { display: block; border: 1px solid #ddd; margin-bottom: 8px; padding: 4px; }
+  .list td { display: block; border: 0; padding: 2px 4px; }
+}
+</style>
diff --git a/db/migrations/1760000012000_price-changes.sql b/db/migrations/1760000012000_price-changes.sql
new file mode 100644
index 0000000..706329a
--- /dev/null
+++ b/db/migrations/1760000012000_price-changes.sql
@@ -0,0 +1,28 @@
+-- Up Migration
+-- M5-T001 practice prices (lld.md §1, SEQ-4): the append-only price_changes history, and the app's right to set a
+-- practice price. Runs as supplements_owner (Q-3, Q-4).
+
+create table price_changes (
+  id bigint generated always as identity constraint pk_price_changes primary key,
+  practice_id bigint not null constraint fk_price_changes_practice references practices (id) on delete restrict,
+  product_id bigint not null constraint fk_price_changes_product references products (id) on delete restrict,
+  old_price_cents integer not null,
+  new_price_cents integer not null,
+  reason text not null constraint ck_price_changes_reason_len check (char_length(reason) between 1 and 200),
+  changed_by bigint not null constraint fk_price_changes_changed_by references users (id) on delete restrict,
+  changed_at timestamptz not null default now(),
+  constraint ck_price_changes_positive check (old_price_cents > 0 and new_price_cents > 0)
+);
+-- EP-27 history, newest first, cursor pagination.
+create index ix_price_changes_practice_changed on price_changes (practice_id, changed_at desc, id desc);
+-- EP-21 "price changed since sent" lookup (M5-T003).
+create index ix_price_changes_practice_product_changed on price_changes (practice_id, product_id, changed_at);
+
+-- INV-4, FR-021: the app may only add and read history; no UPDATE or DELETE.
+grant select, insert on price_changes to supplements_app;
+-- BE-8 sets a practice price (upsert, row lock for the stale check). Rows are never deleted.
+grant insert, update on practice_prices to supplements_app;
+
+-- Down Migration
+revoke insert, update on practice_prices from supplements_app;
+drop table price_changes;
diff --git a/db/migrations/1760000013000_stock-movements.sql b/db/migrations/1760000013000_stock-movements.sql
new file mode 100644
index 0000000..a6e7cfa
--- /dev/null
+++ b/db/migrations/1760000013000_stock-movements.sql
@@ -0,0 +1,32 @@
+-- Up Migration
+-- M5-T002 stock reserve and release (lld.md §1 stock_movements, BE-13, SEQ-2): the append-only stock history, and the
+-- app's right to change a product's stock count. Runs as supplements_owner (Q-3, Q-4).
+
+create table stock_movements (
+  id bigint generated always as identity constraint pk_stock_movements primary key,
+  product_id bigint not null constraint fk_stock_movements_product references products (id) on delete restrict,
+  change integer not null constraint ck_stock_movements_change_nonzero check (change <> 0),
+  kind varchar(20) not null constraint ck_stock_movements_kind check (kind in ('sale', 'sale_release', 'adjustment')),
+  reason text not null constraint ck_stock_movements_reason_len check (char_length(reason) between 1 and 200),
+  order_id bigint constraint fk_stock_movements_order references orders (id) on delete restrict,
+  actor_id bigint constraint fk_stock_movements_actor references users (id) on delete restrict,
+  units_after integer not null constraint ck_stock_movements_units_after_nonneg check (units_after >= 0),
+  created_at timestamptz not null default now(),
+  -- a sale or sale_release names its order and no actor; an adjustment names its actor and no order
+  constraint ck_stock_movements_kind_refs check (
+    (kind in ('sale', 'sale_release') and order_id is not null and actor_id is null)
+    or (kind = 'adjustment' and actor_id is not null and order_id is null)
+  )
+);
+-- EP-31 history, newest first, cursor pagination.
+create index ix_stock_movements_created on stock_movements (created_at desc, id desc);
+create index ix_stock_movements_product on stock_movements (product_id);
+
+-- INV-4: the app may only add and read stock history; no UPDATE or DELETE.
+grant select, insert on stock_movements to supplements_app;
+-- BE-13 changes the count only through a recorded movement; ck_products_stock_nonneg keeps it at or above zero (INV-5).
+grant update (units_in_stock) on products to supplements_app;
+
+-- Down Migration
+revoke update (units_in_stock) on products from supplements_app;
+drop table stock_movements;
