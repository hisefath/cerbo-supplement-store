+// BE-15 PracticeDashboardQueries (lld.md §2, SEQ-5): one practice's attention items, orders, sales and stock for a
+// month. A month is a UTC calendar month (acceptance.md Q-3). Read only; every query is scoped to the viewer's practice.
+import { sql } from 'kysely'
+import { z } from 'zod'
+import { useDb } from '../utils/db'
+import { ProblemError, validationProblem } from '../utils/problem'
+import { assertRole } from './access-policy'
+import { currentPrices } from './catalog'
+import { orderViewLines, type OrderLineRow } from './orders'
+import type { Viewer } from './session'
+
+export interface AttentionItem {
+  kind: 'awaiting_payment' | 'low_stock' | 'out_of_stock'
+  label: string
+  order_id: number | null
+  product_id: number | null
+}
+
+export interface ProductSales {
+  product_id: number
+  name: string
+  units_sold: number
+  patients_paid_cents: number
+  provider_payout_cents: number
+  units_in_stock: number
+}
+
+export interface PracticeDashboard {
+  month: string
+  attention: AttentionItem[]
+  sales: ProductSales[]
+}
+
+export interface PracticeOrderSummary {
+  order_id: number
+  patient_display_name: string
+  total_cents: number
+  status: string
+  sent_at: string
+  paid_at: string | null
+}
+
+export interface PracticeOrderPage {
+  data: PracticeOrderSummary[]
+  next_cursor: string | null
+}
+
+export interface OrdersQuery {
+  month: string
+  cursor?: string
+  limit: number
+}
+
+const DAY_MS = 86_400_000
+const AWAITING_AFTER_MS = 3 * DAY_MS // FR-046: more than 3 days
+const LOW_STOCK_AT = 3 // FR-047: 3 or fewer
+const UNPAID = ['sent', 'in_checkout', 'payment_failed']
+
+const MonthText = z.string().regex(/^\d{4}-(0[1-9]|1[0-2])$/, 'Pick a month like 2026-10.')
+
+/** The month asked for, or the current UTC month when none is given; else 422 /problems/validation. */
+export function parseMonth(raw: unknown, today: Date): string {
+  if (raw === undefined || raw === '') return today.toISOString().slice(0, 7)
+  const parsed = MonthText.safeParse(raw)
+  if (!parsed.success) throw validationProblem(parsed.error)
+  return parsed.data
+}
+
+/** [start, end) of a YYYY-MM month in UTC. */
+export function monthRange(month: string): { start: Date; end: Date } {
+  const [y, m] = month.split('-').map(Number) as [number, number]
+  return { start: new Date(Date.UTC(y, m - 1, 1)), end: new Date(Date.UTC(y, m, 1)) }
+}
+
+export function awaitingPaymentItem(order: { id: string; sent_at: Date }, at: Date): AttentionItem | null {
+  const age = at.getTime() - order.sent_at.getTime()
+  if (age <= AWAITING_AFTER_MS) return null
+  const days = Math.floor(age / DAY_MS) // elapsed 24-hour periods (EDGE-040, AE-043)
+  return { kind: 'awaiting_payment', label: `Awaiting payment for ${days} days`, order_id: Number(order.id), product_id: null }
+}
+
+export function stockItem(p: { id: string; name: string; units_in_stock: number }): AttentionItem | null {
+  if (p.units_in_stock > LOW_STOCK_AT) return null
+  if (p.units_in_stock <= 0) return { kind: 'out_of_stock', label: `${p.name} · out of stock`, order_id: null, product_id: Number(p.id) }
+  return { kind: 'low_stock', label: `Low stock: ${p.units_in_stock} left`, order_id: null, product_id: Number(p.id) }
+}
+
+// The cursor carries PostgreSQL's own text of sent_at, so microseconds survive the round trip (a JS Date would cut
+// them to milliseconds and skip rows on a tie).
+export const encodeCursor = (sentAt: string, id: string): string => Buffer.from(`s:${sentAt}|${id}`).toString('base64url')
+
+export function decodeCursor(cursor: string): { sentAt: string; id: string } | null {
+  const m = /^s:([0-9 :.+-]{10,40})\|(\d{1,18})$/.exec(Buffer.from(cursor, 'base64url').toString())
+  return m ? { sentAt: m[1]!, id: m[2]! } : null
+}
+
+const OrdersQueryShape = z.object({
+  cursor: z.string().refine((c) => decodeCursor(c) !== null, 'Not a cursor from this list.').optional(),
+  limit: z.string().regex(/^\d+$/).transform(Number).pipe(z.int().min(1).max(100)).default(25),
+})
+
+/** EP-30's query string (month, cursor, limit), or 422 /problems/validation. */
+export function parseOrdersQuery(query: Record<string, unknown>, today: Date): OrdersQuery {
+  const month = parseMonth(query.month, today)
+  const parsed = OrdersQueryShape.safeParse(query)
+  if (!parsed.success) throw validationProblem(parsed.error)
+  return { month, limit: parsed.data.limit, ...(parsed.data.cursor === undefined ? {} : { cursor: parsed.data.cursor }) }
+}
+
+function practiceOf(viewer: Viewer | null): string {
+  assertRole(viewer, ['provider'])
+  if (viewer.practiceId === null) throw new ProblemError('forbidden')
+  return viewer.practiceId.toString()
+}
+
+/** EP-29: attention items, then per-product sales of the month's paid orders and today's stock. */
+export async function dashboard(viewer: Viewer, month: string): Promise<PracticeDashboard> {
+  const practiceId = practiceOf(viewer)
+  const { start, end } = monthRange(month)
+  const db = useDb()
+
+  // Age is measured on the database clock, the one that stamped sent_at (default now()): mixing in the app's clock
+  // lets a few milliseconds of skew turn "4 days" into "3 days".
+  const unpaid = await db
+    .selectFrom('orders')
+    .select(['id', 'sent_at', sql<Date>`now()`.as('db_now')])
+    .where('practice_id', '=', practiceId)
+    .where('status', 'in', UNPAID)
+    .where(sql<boolean>`sent_at < now() - interval '3 days'`)
+    .orderBy('sent_at')
+    .orderBy('id')
+    .execute()
+
+  // SEQ-5 step 2: payout per line = paid price × quantity − unit cost × quantity − the line's fee share (FR-028, FR-069).
+  const sales = await db
+    .selectFrom('products')
+    .leftJoin(
+      (eb) =>
+        eb
+          .selectFrom('order_lines')
+          .innerJoin('orders', 'orders.id', 'order_lines.order_id')
+          .select([
+            'order_lines.product_id',
+            sql<string>`sum(order_lines.quantity)`.as('units'),
+            sql<string>`sum(order_lines.paid_unit_price_cents * order_lines.quantity)`.as('paid'),
+            sql<string>`sum((order_lines.paid_unit_price_cents - order_lines.unit_cost_cents_at_payment) * order_lines.quantity - order_lines.fee_share_cents)`.as(
+              'payout',
+            ),
+          ])
+          .where('orders.practice_id', '=', practiceId)
+          .where('orders.status', '=', 'paid')
+          .where('orders.paid_at', '>=', start)
+          .where('orders.paid_at', '<', end)
+          .groupBy('order_lines.product_id')
+          .as('s'),
+      (join) => join.onRef('s.product_id', '=', 'products.id'),
+    )
+    .select(['products.id', 'products.name', 'products.units_in_stock', 's.units', 's.paid', 's.payout'])
+    .orderBy('products.id')
+    .execute()
+
+  const attention = [
+    ...unpaid.map((o) => awaitingPaymentItem(o, o.db_now)),
+    ...sales.map((p) => stockItem(p)),
+  ].filter((a): a is AttentionItem => a !== null)
+
+  return {
+    month,
+    attention,
+    sales: sales.map((p) => ({
+      product_id: Number(p.id),
+      name: p.name,
+      units_sold: Number(p.units ?? 0),
+      patients_paid_cents: Number(p.paid ?? 0),
+      provider_payout_cents: Number(p.payout ?? 0),
+      units_in_stock: p.units_in_stock,
+    })),
+  }
+}
+
+/** EP-30 total = what the patient sees on EP-21: paid -> the amount paid; otherwise EP-21's line prices (a live hold
+ *  -> held prices, else today's practice prices). */
+export function orderTotalCents(
+  o: { status: string; hold_live: boolean; amount_paid_cents: number | null },
+  rows: OrderLineRow[],
+  current: Map<bigint, number>,
+): number {
+  if (o.status === 'paid' && o.amount_paid_cents !== null) return o.amount_paid_cents
+  return orderViewLines(o.status, o.hold_live, rows, current).lines.reduce((s, l) => s + l.line_total_cents, 0)
+}
+
+/** EP-30: the practice's orders sent in the month, newest first (sent_at DESC, id DESC), keyset-paged. */
+export async function orders(viewer: Viewer, query: OrdersQuery): Promise<PracticeOrderPage> {
+  const practiceId = practiceOf(viewer)
+  const { start, end } = monthRange(query.month)
+  let q = useDb()
+    .selectFrom('orders')
+    .innerJoin('users as patient', 'patient.id', 'orders.patient_id')
+    .select([
+      'orders.id',
+      'orders.status',
+      'orders.sent_at',
+      'orders.paid_at',
+      'patient.display_name as patient_display_name',
+      sql<string>`orders.sent_at::text`.as('sent_at_text'),
+      'orders.amount_paid_cents',
+      sql<boolean>`coalesce(orders.prices_held_until > now(), false)`.as('hold_live'),
+    ])
+    .where('orders.practice_id', '=', practiceId)
+    .where('orders.sent_at', '>=', start)
+    .where('orders.sent_at', '<', end)
+  if (query.cursor !== undefined) {
+    const c = decodeCursor(query.cursor)!
+    q = q.where(sql<boolean>`(orders.sent_at, orders.id) < (${c.sentAt}::timestamptz, ${c.id}::bigint)`)
+  }
+  const rows = await q.orderBy('orders.sent_at', 'desc').orderBy('orders.id', 'desc').limit(query.limit + 1).execute()
+  const page = rows.slice(0, query.limit)
+  const last = page[page.length - 1]
+  const lines =
+    page.length === 0
+      ? []
+      : await useDb()
+          .selectFrom('order_lines')
+          .select(['order_id', 'product_id', 'product_name', 'quantity', 'sent_unit_price_cents', 'held_unit_price_cents', 'paid_unit_price_cents'])
+          .where('order_id', 'in', page.map((r) => r.id))
+          .orderBy('id')
+          .execute()
+  const current = await currentPrices(BigInt(practiceId), [...new Set(lines.map((l) => l.product_id))].map(BigInt))
+  return {
+    data: page.map((r) => ({
+      order_id: Number(r.id),
+      patient_display_name: r.patient_display_name,
+      total_cents: orderTotalCents(
+        { status: r.status, hold_live: r.hold_live, amount_paid_cents: r.amount_paid_cents === null ? null : Number(r.amount_paid_cents) },
+        lines.filter((l) => l.order_id === r.id),
+        current,
+      ),
+      status: r.status,
+      sent_at: r.sent_at.toISOString(),
+      paid_at: r.paid_at ? r.paid_at.toISOString() : null,
+    })),
+    next_cursor: rows.length > query.limit && last ? encodeCursor(last.sent_at_text, last.id) : null,
+  }
+}
diff --git a/server/services/pricing.ts b/server/services/pricing.ts
new file mode 100644
index 0000000..8578e21
--- /dev/null
+++ b/server/services/pricing.ts
@@ -0,0 +1,213 @@
+// BE-8 PricingService (lld.md §2, SEQ-4): a practice's price changes only through a recorded, floor-checked change.
+// Reads `products`; writes `practice_prices` and the append-only `price_changes` (INV-4) in one transaction.
+import { sql } from 'kysely'
+import { z } from 'zod'
+import { useDb } from '../utils/db'
+import { ProblemError } from '../utils/problem'
+import { defaultPriceCents, lowestAllowedPriceCents, priceFromMargin } from './money'
+import type { Viewer } from './session'
+
+const HISTORY_PAGE = 25
+
+/** EP-28 body (openapi PriceChangeRequest): exactly one of price_cents or margin_basis_points, and a reason. */
+export const PriceChangeRequest = z
+  .strictObject({
+    price_cents: z.int().positive().optional(),
+    margin_basis_points: z.int().min(0).max(9999).optional(),
+    reason: z.string().trim().min(1, 'Add a reason so others know why the price changed.').max(200),
+    expected_current_price_cents: z.int().positive(),
+  })
+  .refine((b) => (b.price_cents === undefined) !== (b.margin_basis_points === undefined), {
+    message: 'Enter a new price or a margin, not both.',
+    path: ['price_cents'],
+  })
+export type PriceChangeInput = z.infer<typeof PriceChangeRequest>
+
+export interface PracticePrice {
+  product_id: number
+  name: string
+  unit_cost_cents: number
+  price_cents: number
+  margin_basis_points: number
+  is_default: boolean
+  set_by_display_name: string | null
+  lowest_allowed_price_cents: number
+}
+
+export interface PriceChange {
+  product_name: string
+  changed_by_display_name: string
+  changed_at: Date
+  old_price_cents: number
+  new_price_cents: number
+  reason: string
+}
+
+export interface PriceList {
+  prices: PracticePrice[]
+  history: PriceChange[]
+  history_next_cursor: string | null
+}
+
+/** (price − cost) ÷ price in basis points, rounded half-up (openapi PracticePrice.margin_basis_points). */
+export function marginBasisPoints(priceCents: number, unitCostCents: number): number {
+  return Math.floor(((priceCents - unitCostCents) * 20000 + priceCents) / (2 * priceCents))
+}
+
+/** The price a change asks for, or /problems/below-price-floor with the lowest allowed price (FR-018, FR-020). */
+export function priceFor(productId: bigint, unitCostCents: number, input: { price_cents?: number; margin_basis_points?: number }): number {
+  const price = input.price_cents ?? priceFromMargin(unitCostCents, input.margin_basis_points!)
+  const lowest = lowestAllowedPriceCents(unitCostCents)
+  if (price < lowest) throw new ProblemError('below-price-floor', { lowestAllowedPriceCents: lowest, productIds: [Number(productId)] })
+  return price
+}
+
+/** Opaque history cursor: the last row's changed_at (PostgreSQL text, microseconds kept) and id. */
+export function encodeCursor(at: string, id: string): string {
+  return Buffer.from(JSON.stringify([at, id])).toString('base64url')
+}
+
+export function decodeCursor(cursor: string): { at: string; id: string } {
+  let v: unknown
+  try {
+    v = JSON.parse(Buffer.from(cursor, 'base64url').toString())
+  } catch {
+    v = undefined
+  }
+  if (
+    Array.isArray(v) &&
+    v.length === 2 &&
+    typeof v[0] === 'string' &&
+    !Number.isNaN(Date.parse(v[0])) &&
+    typeof v[1] === 'string' &&
+    /^\d{1,18}$/.test(v[1])
+  ) {
+    return { at: v[0], id: v[1] }
+  }
+  throw new ProblemError('validation', { errors: [{ pointer: '#/query/history_cursor', detail: 'Unknown cursor.' }] })
+}
+
+function practiceOf(viewer: Viewer): string {
+  if (viewer.practiceId === null) throw new ProblemError('forbidden')
+  return viewer.practiceId.toString()
+}
+
+function toPracticePrice(
+  r: { id: string; name: string; unit_cost_cents: number },
+  price: number | null,
+  setBy: string | null,
+): PracticePrice {
+  const p = price ?? defaultPriceCents(r.unit_cost_cents)
+  return {
+    product_id: Number(r.id),
+    name: r.name,
+    unit_cost_cents: r.unit_cost_cents,
+    price_cents: p,
+    margin_basis_points: marginBasisPoints(p, r.unit_cost_cents),
+    is_default: price === null,
+    set_by_display_name: price === null ? null : setBy,
+    lowest_allowed_price_cents: lowestAllowedPriceCents(r.unit_cost_cents),
+  }
+}
+
+/** EP-27: every product at this practice's price, plus one page of its history, newest first (FR-017, FR-019). */
+export async function listPrices(viewer: Viewer, historyCursor?: string): Promise<PriceList> {
+  const practiceId = practiceOf(viewer)
+  const after = historyCursor ? decodeCursor(historyCursor) : undefined
+  const db = useDb()
+  const rows = await db
+    .selectFrom('products')
+    .leftJoin('practice_prices', (j) => j.onRef('practice_prices.product_id', '=', 'products.id').on('practice_prices.practice_id', '=', practiceId))
+    .leftJoin('users', 'users.id', 'practice_prices.set_by')
+    .select(['products.id', 'products.name', 'products.unit_cost_cents', 'practice_prices.price_cents', 'users.display_name'])
+    .orderBy('products.name')
+    .execute()
+  let history = db
+    .selectFrom('price_changes')
+    .innerJoin('products', 'products.id', 'price_changes.product_id')
+    .innerJoin('users', 'users.id', 'price_changes.changed_by')
+    .select([
+      'price_changes.id',
+      sql<string>`price_changes.changed_at::text`.as('at'),
+      'price_changes.changed_at',
+      'products.name as product_name',
+      'users.display_name as changed_by_display_name',
+      'price_changes.old_price_cents',
+      'price_changes.new_price_cents',
+      'price_changes.reason',
+    ])
+    .where('price_changes.practice_id', '=', practiceId)
+  if (after) history = history.where(sql<boolean>`(price_changes.changed_at, price_changes.id) < (${after.at}::timestamptz, ${after.id}::bigint)`)
+  const page = await history.orderBy('price_changes.changed_at', 'desc').orderBy('price_changes.id', 'desc').limit(HISTORY_PAGE + 1).execute()
+  const more = page.length > HISTORY_PAGE
+  const shown = page.slice(0, HISTORY_PAGE)
+  const last = shown.at(-1)
+  return {
+    prices: rows.map((r) => toPracticePrice(r, r.price_cents, r.display_name)),
+    history: shown.map(({ id: _id, at: _at, ...h }) => h),
+    history_next_cursor: more && last ? encodeCursor(last.at, last.id) : null,
+  }
+}
+
+/** EP-28: sets the practice price and records the change, or refuses (floor, stale form, unknown product). */
+export async function changePrice(viewer: Viewer, productId: bigint, input: PriceChangeInput): Promise<PracticePrice> {
+  const practiceId = practiceOf(viewer)
+  const product = await useDb()
+    .selectFrom('products')
+    .select(['id', 'name', 'unit_cost_cents'])
+    .where('id', '=', productId.toString())
+    .executeTakeFirst()
+  if (!product) throw new ProblemError('not-found')
+  const price = priceFor(productId, product.unit_cost_cents, input)
+
+  await useDb().transaction().execute(async (tx) => {
+    const current = async () => {
+      const row = await tx
+        .selectFrom('practice_prices')
+        .select(['price_cents', 'set_by'])
+        .where('practice_id', '=', practiceId)
+        .where('product_id', '=', product.id)
+        .forUpdate()
+        .executeTakeFirst()
+      return row ?? null
+    }
+    const stale = async (): Promise<never> => {
+      const row = await current()
+      const by = row
+        ? await tx.selectFrom('users').select('display_name').where('id', '=', row.set_by).executeTakeFirst()
+        : undefined
+      throw new ProblemError('stale-price', {
+        currentPriceCents: row?.price_cents ?? defaultPriceCents(product.unit_cost_cents),
+        changedBy: by?.display_name ?? null,
+      })
+    }
+    const row = await current()
+    const old = row?.price_cents ?? defaultPriceCents(product.unit_cost_cents)
+    if (old !== input.expected_current_price_cents) await stale()
+    // The row lock covers an existing price; the WHERE covers two first changes racing to insert one.
+    const set = await tx
+      .insertInto('practice_prices')
+      .values({ practice_id: practiceId, product_id: product.id, price_cents: price, set_by: viewer.userId.toString() })
+      .onConflict((oc) =>
+        oc
+          .columns(['practice_id', 'product_id'])
+          .doUpdateSet({ price_cents: price, set_by: viewer.userId.toString(), set_at: sql<Date>`now()` })
+          .where('practice_prices.price_cents', '=', old),
+      )
+      .returning('price_cents')
+      .executeTakeFirst()
+    if (!set) await stale()
+    await tx
+      .insertInto('price_changes')
+      .values({
+        practice_id: practiceId,
+        product_id: product.id,
+        old_price_cents: old,
+        new_price_cents: price,
+        reason: input.reason,
+        changed_by: viewer.userId.toString(),
+      })
+      .execute()
+  })
+  return toPracticePrice(product, price, viewer.displayName)
+}
diff --git a/server/services/stock-adjustments.ts b/server/services/stock-adjustments.ts
new file mode 100644
index 0000000..7e83fc3
--- /dev/null
+++ b/server/services/stock-adjustments.ts
@@ -0,0 +1,105 @@
+// BE-13 StockService, staff side (lld.md §2, SEQ-6): adjust and listStock. Platform staff change stock only through an
+// `adjustment` movement that records who, why and the count after (FR-030, INV-4); stock never goes below zero (INV-5).
+// reserveForOrder and releaseForOrder stay in stock.ts (M5-T002).
+import { sql } from 'kysely'
+import { z } from 'zod'
+import { useDb } from '../utils/db'
+import { ProblemError } from '../utils/problem'
+import { decodeCursor, encodeCursor } from './pricing'
+import type { Viewer } from './session'
+
+const HISTORY_PAGE = 25
+
+/** EP-32 body (openapi StockAdjustmentRequest). confirm_large_change is the S7 form's own check; the server accepts it. */
+export const StockAdjustmentRequest = z.strictObject({
+  change: z.int().refine((n) => n !== 0, 'Enter a whole number, like 12 or -3.'),
+  reason: z.string().trim().min(1, 'Add a reason so others know why stock changed.').max(200),
+  expected_units_in_stock: z.int().min(0),
+  confirm_large_change: z.boolean().default(false),
+})
+export type StockAdjustmentInput = z.infer<typeof StockAdjustmentRequest>
+
+export interface StockMovement {
+  product_name: string
+  change: number
+  kind: 'sale' | 'sale_release' | 'adjustment'
+  reason: string
+  actor_display_name: string | null
+  created_at: Date
+  units_in_stock_after: number
+}
+
+export interface StockList {
+  products: { product_id: number; name: string; units_in_stock: number }[]
+  history: StockMovement[]
+  history_next_cursor: string | null
+}
+
+/** The count after the change, or /problems/stale-stock (the form saw an old count) or /problems/insufficient-stock
+ *  (it would go below zero). */
+export function checkAdjustment(productId: bigint, unitsInStock: number, input: { change: number; expected_units_in_stock: number }): number {
+  if (input.expected_units_in_stock !== unitsInStock) throw new ProblemError('stale-stock', { unitsInStock })
+  const after = unitsInStock + input.change
+  if (after < 0) throw new ProblemError('insufficient-stock', { productIds: [Number(productId)], unitsAvailable: [unitsInStock] })
+  return after
+}
+
+/** EP-32: one transaction locks the product, checks the count, updates it and appends the movement (SEQ-6 step 5). */
+export async function adjust(viewer: Viewer, productId: bigint, input: StockAdjustmentInput): Promise<StockMovement> {
+  return useDb().transaction().execute(async (tx) => {
+    const p = await tx
+      .selectFrom('products')
+      .select(['id', 'name', 'units_in_stock'])
+      .where('id', '=', productId.toString())
+      .forUpdate()
+      .executeTakeFirst()
+    if (!p) throw new ProblemError('not-found')
+    const after = checkAdjustment(productId, p.units_in_stock, input)
+    await tx.updateTable('products').set({ units_in_stock: after }).where('id', '=', p.id).execute()
+    const m = await tx
+      .insertInto('stock_movements')
+      .values({ product_id: p.id, change: input.change, kind: 'adjustment', reason: input.reason, actor_id: viewer.userId.toString(), units_after: after })
+      .returning('created_at')
+      .executeTakeFirstOrThrow()
+    return {
+      product_name: p.name,
+      change: input.change,
+      kind: 'adjustment',
+      reason: input.reason,
+      actor_display_name: viewer.displayName,
+      created_at: m.created_at,
+      units_in_stock_after: after,
+    }
+  })
+}
+
+/** EP-31: every product's count, plus one page of every stock movement, newest first (FR-029, FR-030). */
+export async function listStock(_viewer: Viewer, historyCursor?: string): Promise<StockList> {
+  const after = historyCursor ? decodeCursor(historyCursor) : undefined
+  const db = useDb()
+  const products = await db.selectFrom('products').select(['id', 'name', 'units_in_stock']).orderBy('name').execute()
+  let history = db
+    .selectFrom('stock_movements')
+    .innerJoin('products', 'products.id', 'stock_movements.product_id')
+    .leftJoin('users', 'users.id', 'stock_movements.actor_id')
+    .select([
+      'stock_movements.id',
+      sql<string>`stock_movements.created_at::text`.as('at'),
+      'products.name as product_name',
+      'stock_movements.change',
+      'stock_movements.kind',
+      'stock_movements.reason',
+      'users.display_name as actor_display_name',
+      'stock_movements.created_at',
+      'stock_movements.units_after as units_in_stock_after',
+    ])
+  if (after) history = history.where(sql<boolean>`(stock_movements.created_at, stock_movements.id) < (${after.at}::timestamptz, ${after.id}::bigint)`)
+  const page = await history.orderBy('stock_movements.created_at', 'desc').orderBy('stock_movements.id', 'desc').limit(HISTORY_PAGE + 1).execute()
+  const shown = page.slice(0, HISTORY_PAGE)
+  const last = shown.at(-1)
+  return {
+    products: products.map((p) => ({ product_id: Number(p.id), name: p.name, units_in_stock: p.units_in_stock })),
+    history: shown.map(({ id: _id, at: _at, ...h }) => h),
+    history_next_cursor: page.length > HISTORY_PAGE && last ? encodeCursor(last.at, last.id) : null,
+  }
+}
diff --git a/server/services/stock.ts b/server/services/stock.ts
new file mode 100644
index 0000000..4c99b27
--- /dev/null
+++ b/server/services/stock.ts
@@ -0,0 +1,75 @@
+// BE-13 StockService (lld.md §2, SEQ-2, INV-5): stock counts change only through recorded movements that never go
+// below zero. reserveForOrder and releaseForOrder run inside BE-10's payment transactions; product rows are always
+// locked in id order, so two payments for the same products wait on each other instead of deadlocking (AE-024).
+import type { Transaction } from 'kysely'
+import type { Database } from '../utils/db-types'
+import { ProblemError } from '../utils/problem'
+
+export interface StockNeed {
+  productId: string
+  quantity: number
+  unitsInStock: number
+}
+
+/** The lines that want more than is in stock, named as /problems/insufficient-stock names them; null when none. */
+export function shortOfStock(needs: StockNeed[]): { productIds: number[]; unitsAvailable: number[] } | null {
+  const short = needs.filter((n) => n.quantity > n.unitsInStock)
+  if (short.length === 0) return null
+  return { productIds: short.map((n) => Number(n.productId)), unitsAvailable: short.map((n) => n.unitsInStock) }
+}
+
+/** Units of each product an order's sale movements took and its releases have not yet given back. */
+export function outstandingByProduct(moves: { product_id: string; change: number }[]): Map<string, number> {
+  const out = new Map<string, number>()
+  for (const m of moves) out.set(m.product_id, (out.get(m.product_id) ?? 0) - m.change)
+  for (const [id, n] of out) if (n <= 0) out.delete(id)
+  return out
+}
+
+const byId = (a: string, b: string) => (BigInt(a) < BigInt(b) ? -1 : BigInt(a) > BigInt(b) ? 1 : 0)
+
+async function lockProducts(tx: Transaction<Database>, productIds: string[]) {
+  return tx.selectFrom('products').select(['id', 'units_in_stock']).where('id', 'in', productIds).orderBy('id').forUpdate().execute()
+}
+
+async function move(tx: Transaction<Database>, orderId: string, productId: string, change: number, kind: 'sale' | 'sale_release') {
+  const p = await tx
+    .updateTable('products')
+    .set((eb) => ({ units_in_stock: eb('units_in_stock', '+', change) }))
+    .where('id', '=', productId)
+    .returning('units_in_stock')
+    .executeTakeFirstOrThrow()
+  await tx
+    .insertInto('stock_movements')
+    .values({ product_id: productId, change, kind, reason: `Order ${orderId}`, order_id: orderId, units_after: p.units_in_stock })
+    .execute()
+}
+
+/** FR-026, FR-027: lowers stock by each line's quantity with a `sale` movement, or refuses the whole order with
+ *  /problems/insufficient-stock naming the short items (the caller's transaction then rolls back: no charge). */
+export async function reserveForOrder(tx: Transaction<Database>, orderId: bigint): Promise<void> {
+  const id = orderId.toString()
+  const lines = await tx.selectFrom('order_lines').select(['product_id', 'quantity']).where('order_id', '=', id).execute()
+  if (lines.length === 0) return
+  const stock = new Map((await lockProducts(tx, lines.map((l) => l.product_id))).map((p) => [p.id, p.units_in_stock]))
+  const short = shortOfStock(lines.map((l) => ({ productId: l.product_id, quantity: l.quantity, unitsInStock: stock.get(l.product_id) ?? 0 })))
+  if (short) throw new ProblemError('insufficient-stock', short)
+  for (const l of [...lines].sort((a, b) => byId(a.product_id, b.product_id))) await move(tx, id, l.product_id, -l.quantity, 'sale')
+}
+
+/** FR-035, FM-1, FM-3: gives back what the order reserved and has not yet returned, with `sale_release` movements.
+ *  Returns nothing when nothing is out, so calling it twice for one reservation is harmless. */
+export async function releaseForOrder(tx: Transaction<Database>, orderId: bigint): Promise<void> {
+  const id = orderId.toString()
+  const moves = await tx
+    .selectFrom('stock_movements')
+    .select(['product_id', 'change'])
+    .where('order_id', '=', id)
+    .where('kind', 'in', ['sale', 'sale_release'])
+    .execute()
+  const out = outstandingByProduct(moves)
+  if (out.size === 0) return
+  const productIds = [...out.keys()].sort(byId)
+  await lockProducts(tx, productIds)
+  for (const p of productIds) await move(tx, id, p, out.get(p)!, 'sale_release')
+}
