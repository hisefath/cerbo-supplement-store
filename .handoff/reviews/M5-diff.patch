index 0000000..23a9de6
--- /dev/null
+++ b/app/components/practice-prices/PriceChangeDialog.vue
@@ -0,0 +1,173 @@
+<!-- FE-14 PriceChangeDialog (S5): stateless. The draft (ST-6) is lifted to FE-13, which sends it (EP-28). Shows the
+     lowest allowed price, the price a margin makes, and the field errors under their fields. -->
+<script lang="ts">
+/** "37.50" → 3750; "60" → 6000. Two decimals at most; null when it is not a number. No floats (AGENTS.md). */
+export function toHundredths(s: string): number | null {
+  const m = /^\s*(\d{1,7})(?:\.(\d{1,2}))?\s*$/.exec(s)
+  return m ? Number(m[1]) * 100 + Number((m[2] ?? '').padEnd(2, '0')) : null
+}
+
+export const dollars = (c: number) => `$${(c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
+
+const BOTH_OR_NEITHER = 'Enter a new price or a margin, not both.'
+
+/** A 422 /problems/validation `errors[]` (pointer, detail) as S5 copy under the field each one names. */
+export function fieldErrors(
+  errors: { pointer: string; detail: string }[] | undefined,
+  lowestAllowedPriceCents: number,
+): { price?: string; reason?: string; form?: string } {
+  const out: { price?: string; reason?: string; form?: string } = {}
+  for (const { pointer, detail } of errors ?? []) {
+    if (detail === BOTH_OR_NEITHER) out.price = detail
+    else if (pointer === '#/price_cents') {
+      const floor = dollars(lowestAllowedPriceCents)
+      out.price ??= `That price is below the lowest allowed, ${floor}. Enter ${floor} or more.`
+    } else if (pointer === '#/margin_basis_points') out.price ??= 'Enter a margin from 0 to 99.99.'
+    else if (pointer === '#/reason') out.reason ??= detail
+    else out.form ??= detail
+  }
+  if (!out.price && !out.reason && !out.form) out.form = "We couldn't save the new price. The old price still applies. Try again."
+  return out
+}
+
+/** S5 "keeps focus inside until closed": Tab and Shift+Tab wrap between the dialog's first and last control. */
+export function trapTab(e: KeyboardEvent, root: HTMLElement, active: Element | null) {
+  const items = [...root.querySelectorAll<HTMLElement>('input:not([disabled]), button:not([disabled])')]
+  const first = items[0]
+  const last = items[items.length - 1]
+  if (!first || !last) return
+  const target = e.shiftKey ? (active === first || !root.contains(active) ? last : null) : active === last || !root.contains(active) ? first : null
+  if (target) {
+    e.preventDefault()
+    target.focus()
+  }
+}
+</script>
+
+<script setup lang="ts">
+import { priceFromMargin } from '~~/server/services/money'
+
+export interface PracticePrice {
+  product_id: number
+  name: string
+  unit_cost_cents: number
+  price_cents: number
+  margin_basis_points: number
+  is_default: boolean
+  set_by_display_name: string | null
+  lowest_allowed_price_cents: number
+}
+export interface PriceDraft {
+  mode: 'price' | 'margin'
+  price: string
+  margin: string
+  reason: string
+}
+export interface DraftErrors {
+  price?: string
+  reason?: string
+  form?: string
+}
+
+const props = defineProps<{ price: PracticePrice; draft: PriceDraft; errors: DraftErrors; saving: boolean; slow: boolean }>()
+const emit = defineEmits<{ change: [draft: PriceDraft]; save: []; cancel: [] }>()
+
+const set = (patch: Partial<PriceDraft>) => emit('change', { ...props.draft, ...patch })
+const marginPreview = computed(() => {
+  if (props.draft.mode !== 'margin') return null
+  const bp = toHundredths(props.draft.margin)
+  return bp === null || bp > 9999 ? null : priceFromMargin(props.price.unit_cost_cents, bp)
+})
+const dialog = ref<HTMLElement | null>(null)
+onMounted(() => dialog.value?.querySelector<HTMLInputElement>('input')?.focus())
+const onTab = (e: KeyboardEvent) => dialog.value && trapTab(e, dialog.value, document.activeElement)
+</script>
+
+<template>
+  <div class="backdrop">
+    <section
+      ref="dialog"
+      class="dialog"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="price-dialog-title"
+      @keydown.esc="emit('cancel')"
+      @keydown.tab="onTab"
+    >
+      <h2 id="price-dialog-title">Change price: {{ price.name }}</h2>
+      <form novalidate @submit.prevent="emit('save')">
+        <fieldset>
+          <legend>Enter one:</legend>
+          <div class="choice">
+            <input id="mode-price" type="radio" name="mode" :checked="draft.mode === 'price'" @change="set({ mode: 'price' })" />
+            <label for="mode-price">New price</label>
+            <input
+              id="new-price"
+              :value="draft.price"
+              inputmode="decimal"
+              aria-label="New price"
+              aria-describedby="new-price-help price-error"
+              :disabled="draft.mode !== 'price'"
+              @input="set({ price: ($event.target as HTMLInputElement).value })"
+            />
+            <p id="new-price-help" class="helper">In dollars, like 37.50.</p>
+          </div>
+          <div class="choice">
+            <input id="mode-margin" type="radio" name="mode" :checked="draft.mode === 'margin'" @change="set({ mode: 'margin' })" />
+            <label for="mode-margin">Margin %</label>
+            <input
+              id="margin"
+              :value="draft.margin"
+              inputmode="decimal"
+              aria-label="Margin %"
+              aria-describedby="margin-help price-error"
+              :disabled="draft.mode !== 'margin'"
+              @input="set({ margin: ($event.target as HTMLInputElement).value })"
+            />
+            <p id="margin-help" class="helper">Share of the patient price you keep before the platform fee.</p>
+          </div>
+        </fieldset>
+        <p v-if="marginPreview !== null" role="status">
+          A {{ draft.margin }}% margin makes the price {{ dollars(marginPreview) }}. Check before saving.
+        </p>
+        <p class="floor">Lowest allowed price: {{ dollars(price.lowest_allowed_price_cents) }}</p>
+        <p v-if="errors.price" id="price-error" class="error" role="alert">{{ errors.price }}</p>
+
+        <label for="reason">Reason (required)</label>
+        <input
+          id="reason"
+          :value="draft.reason"
+          maxlength="200"
+          aria-describedby="reason-help reason-error"
+          @input="set({ reason: ($event.target as HTMLInputElement).value })"
+        />
+        <p id="reason-help" class="helper">Shown in the price history.</p>
+        <p v-if="errors.reason" id="reason-error" class="error" role="alert">{{ errors.reason }}</p>
+
+        <p v-if="errors.form" class="error" role="alert">{{ errors.form }}</p>
+        <p v-if="saving" role="status">{{ slow ? "Still saving. Don't close this window." : 'Saving…' }}</p>
+        <div class="actions">
+          <button type="submit" :disabled="saving">Save new price</button>
+          <button type="button" @click="emit('cancel')">Cancel</button>
+        </div>
+      </form>
+    </section>
+  </div>
+</template>
+
+<style scoped>
+.backdrop { position: fixed; inset: 0; background: rgb(0 0 0 / 40%); display: flex; align-items: center; justify-content: center; }
+.dialog { background: #fff; padding: 16px 20px; max-width: 480px; width: 100%; }
+fieldset { border: 0; padding: 0; margin: 0; }
+.choice { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 4px 0; }
+.choice input[type='radio'] { width: 24px; height: 24px; }
+.helper { flex-basis: 100%; margin: 0; color: #444; font-size: 14px; }
+.floor { color: #1a1a1a; }
+.error { color: #b00020; }
+#reason { display: block; width: 100%; }
+.actions { display: flex; gap: 8px; margin-top: 12px; }
+.actions button { min-height: 32px; }
+@media (max-width: 600px) {
+  .dialog { max-width: none; height: 100%; overflow: auto; }
+}
+</style>
diff --git a/app/pages/ops/stock.vue b/app/pages/ops/stock.vue
new file mode 100644
index 0000000..1295a46
--- /dev/null
+++ b/app/pages/ops/stock.vue
@@ -0,0 +1,256 @@
+<!-- FE-16 StockAdjustmentsPage (S7, EP-9): every product's stock (EP-31), the change form (EP-32) and the permanent
+     stock history. Owns ST-10, the change draft, and one Idempotency-Key per save, kept for its retries. -->
+<script setup lang="ts">
+import type { StockDraft, StockDraftErrors } from '~/components/ops-stock/ChangeForm.vue'
+import type { Problem } from '~/components/ProblemMessage.vue'
+
+interface StockProduct {
+  product_id: number
+  name: string
+  units_in_stock: number
+}
+interface StockMovement {
+  product_name: string
+  change: number
+  kind: string
+  reason: string
+  actor_display_name: string | null
+  created_at: string
+  units_in_stock_after: number
+}
+interface StockList {
+  products: StockProduct[]
+  history: StockMovement[]
+  history_next_cursor: string | null
+}
+
+const LARGE_CHANGE = 10_000
+
+useHead({ title: 'Stock adjustments' })
+const route = useRoute()
+const { data: list, error, refresh, status } = await useFetch<StockList>('/api/ops/stock') // ST-8, first page
+// "Show 25 more" appends older pages under the first one (R4); a reload starts from the first page again.
+const older = ref<StockMovement[]>([])
+const olderCursor = ref<string | null | undefined>(undefined)
+const loadingMore = ref(false)
+const moreProblem = ref<Problem | null>(null)
+const history = computed(() => [...(list.value?.history ?? []), ...older.value])
+const nextCursor = computed(() => (olderCursor.value === undefined ? list.value?.history_next_cursor ?? null : olderCursor.value))
+
+const editing = ref<StockProduct | null>(null)
+const draft = ref<StockDraft>({ change: '', reason: '' }) // ST-10
+const errors = ref<StockDraftErrors>({})
+const key = ref<string | null>(null)
+const confirmed = ref(false)
+const saving = ref(false)
+const slow = ref(false)
+const success = ref('')
+
+const signed = (n: number) => (n > 0 ? `+${n}` : `${n}`)
+// UTC on server and browser alike, so the SSR text and the hydrated text match (R6).
+const when = (iso: string) =>
+  new Date(iso).toLocaleString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
+const slugOf = (p?: Problem | null) => p?.type?.replace('/problems/', '')
+// S7 Permission denied, signed out: the sign-in page with the idle message (as IdleCountdown does).
+const toSignIn = () => navigateTo({ path: '/sign-in', query: { next: route.fullPath, idle: '1' } })
+if (slugOf(error.value?.data as Problem | undefined) === 'unauthenticated') await toSignIn()
+
+async function reload() {
+  older.value = []
+  olderCursor.value = undefined
+  moreProblem.value = null
+  await refresh()
+}
+async function showMore() {
+  if (!nextCursor.value || loadingMore.value) return
+  loadingMore.value = true
+  moreProblem.value = null
+  try {
+    const page = await $fetch<StockList>('/api/ops/stock', { query: { history_cursor: nextCursor.value } })
+    older.value = [...older.value, ...page.history]
+    olderCursor.value = page.history_next_cursor
+  } catch (e: unknown) {
+    const data = (e as { data?: Problem }).data
+    if (slugOf(data) === 'unauthenticated') await toSignIn()
+    else moreProblem.value = navigator.onLine ? data ?? { type: '/problems/internal' } : { type: '/problems/offline' }
+  } finally {
+    loadingMore.value = false
+  }
+}
+const belowZero = (n: number) => `That would take stock below 0. ${n} are in stock.`
+
+function open(p: StockProduct) {
+  editing.value = p
+  draft.value = { change: '', reason: '' }
+  errors.value = {}
+  key.value = null
+  confirmed.value = false
+  success.value = ''
+}
+function close() {
+  const id = editing.value?.product_id
+  editing.value = null
+  nextTick(() => document.getElementById(`record-${id}`)?.focus())
+}
+function onChange(d: StockDraft) {
+  draft.value = d
+  key.value = null // a different request needs its own key
+  confirmed.value = false
+}
+
+async function save() {
+  const p = editing.value
+  if (!p || saving.value) return
+  const text = draft.value.change.trim()
+  const change = /^[+-]?\d{1,9}$/.test(text) ? Number(text) : 0
+  const next: StockDraftErrors = {}
+  if (change === 0) next.change = 'Enter a whole number, like 12 or -3.'
+  else if (p.units_in_stock + change < 0) next.change = belowZero(p.units_in_stock)
+  if (draft.value.reason.trim() === '') next.reason = 'Add a reason so others know why stock changed.'
+  if (!next.change && !next.reason && Math.abs(change) >= LARGE_CHANGE && !confirmed.value) {
+    next.confirm = `${change > 0 ? 'Add' : 'Remove'} ${Math.abs(change).toLocaleString('en-US')} units? Check before saving.`
+    confirmed.value = true
+  }
+  errors.value = next
+  if (next.change || next.reason || next.confirm) return
+
+  saving.value = true
+  const timer = setTimeout(() => (slow.value = true), 10_000)
+  key.value ??= crypto.randomUUID()
+  try {
+    const saved = await $fetch<StockMovement>(`/api/ops/stock/${p.product_id}/adjustments`, {
+      method: 'POST',
+      headers: { 'idempotency-key': key.value },
+      body: {
+        change,
+        reason: draft.value.reason.trim(),
+        expected_units_in_stock: p.units_in_stock,
+        confirm_large_change: confirmed.value,
+      },
+    })
+    success.value = `${saved.product_name} stock is now ${saved.units_in_stock_after}.`
+    close()
+    await reload()
+  } catch (e: unknown) {
+    const data = (e as { data?: Problem & { unitsInStock?: number; errors?: { pointer: string; detail: string }[] } }).data
+    const slug = slugOf(data)
+    if (slug === 'unauthenticated') {
+      await toSignIn()
+    } else if (slug === 'forbidden') {
+      errors.value = { form: 'Only platform staff can change stock.' }
+    } else if (slug === 'idempotency-in-flight') {
+      // The first save with this key is still running: its outcome is unknown, so never claim the old count. The key
+      // is kept, so saving again replays that same request.
+      errors.value = { form: "Still saving. Don't close this window." }
+    } else if (slug === 'stale-stock') {
+      errors.value = { form: `Stock changed while you were here. It's now ${data!.unitsInStock}. Check your change.` }
+      await reload()
+      editing.value = list.value?.products.find((x) => x.product_id === p.product_id) ?? p
+    } else if (slug === 'insufficient-stock') {
+      errors.value = { change: belowZero(data!.unitsAvailable?.[0] ?? p.units_in_stock) }
+    } else if (slug === 'validation') {
+      const errs = data!.errors ?? []
+      errors.value = {
+        change: errs.some((x) => !x.pointer.startsWith('#/reason')) ? 'Enter a whole number, like 12 or -3.' : undefined,
+        reason: errs.some((x) => x.pointer.startsWith('#/reason')) ? 'Add a reason so others know why stock changed.' : undefined,
+      }
+    } else if (!navigator.onLine) {
+      errors.value = { form: "You're offline. Stock is unchanged." }
+    } else {
+      errors.value = { form: `We couldn't save the change. Stock is still ${p.units_in_stock}. Try again.` }
+    }
+  } finally {
+    clearTimeout(timer)
+    saving.value = false
+    slow.value = false
+  }
+}
+const pageProblem = computed<Problem | null>(() => (error.value ? (error.value.data as Problem) ?? { type: '/problems/internal' } : null))
+</script>
+
+<template>
+  <AppShell>
+    <section class="stock" aria-labelledby="stock-heading">
+      <h1 id="stock-heading">Stock adjustments</h1>
+      <p v-if="status === 'pending' && !list" role="status">Loading stock…</p>
+      <ProblemMessage
+        v-else-if="pageProblem"
+        :problem="pageProblem"
+        :copy="{ forbidden: 'Only platform staff can change stock.' }"
+        @retry="reload()"
+      />
+      <template v-else-if="list">
+        <p class="success" role="status">{{ success }}</p>
+        <table class="list">
+          <thead>
+            <tr>
+              <th scope="col">Product</th><th scope="col">In stock</th><th scope="col"><span class="visually-hidden">Actions</span></th>
+            </tr>
+          </thead>
+          <tbody>
+            <template v-for="p in list.products" :key="p.product_id">
+              <tr>
+                <td>{{ p.name }}</td>
+                <td>{{ p.units_in_stock }}</td>
+                <td>
+                  <button :id="`record-${p.product_id}`" type="button" :aria-label="`Record a change for ${p.name}`" @click="open(p)">
+                    Record a change
+                  </button>
+                </td>
+              </tr>
+              <!-- S7 Accessibility: the form opens in place under its row (a full-screen sheet on phones). -->
+              <tr v-if="editing?.product_id === p.product_id" class="form-row">
+                <td colspan="3">
+                  <OpsStockChangeForm
+                    :name="p.name"
+                    :draft="draft"
+                    :errors="errors"
+                    :saving="saving"
+                    :slow="slow"
+                    @change="onChange"
+                    @save="save"
+                    @cancel="close"
+                  />
+                </td>
+              </tr>
+            </template>
+          </tbody>
+        </table>
+
+        <h2>Stock history</h2>
+        <p class="helper">Times in UTC</p>
+        <p v-if="history.length === 0">No stock changes recorded yet.</p>
+        <ul v-else class="history">
+          <li v-for="(h, i) in history" :key="i">
+            <span>{{ when(h.created_at) }}</span> <span v-if="h.actor_display_name">{{ h.actor_display_name }}</span>
+            <span>{{ h.product_name }}</span> <span>{{ signed(h.change) }}</span> <q>{{ h.reason }}</q>
+          </li>
+        </ul>
+        <p v-if="loadingMore" role="status">Loading stock…</p>
+        <ProblemMessage
+          v-if="moreProblem"
+          :problem="moreProblem"
+          :copy="{ forbidden: 'Only platform staff can change stock.' }"
+          @retry="showMore()"
+        />
+        <button v-if="nextCursor" type="button" :disabled="loadingMore" @click="showMore()">Show 25 more</button>
+      </template>
+    </section>
+  </AppShell>
+</template>
+
+<style scoped>
+.list { width: 100%; border-collapse: collapse; }
+.list th, .list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #ddd; overflow-wrap: anywhere; }
+.list button { min-height: 24px; min-width: 24px; }
+.history { list-style: none; padding: 0; }
+.history li { padding: 6px 0; border-bottom: 1px solid #eee; display: flex; flex-wrap: wrap; gap: 8px; }
+.form-row td { padding: 0; }
+.helper { margin: 2px 0; color: #444; font-size: 14px; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
+@media (max-width: 600px) {
+  .list thead { display: none; }
+  .list tr { display: block; border: 1px solid #ddd; margin-bottom: 8px; padding: 4px; }
+  .list td { display: block; border: 0; padding: 2px 4px; }
+}
+</style>
